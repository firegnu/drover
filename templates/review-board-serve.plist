<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 看板的本机服务：http://127.0.0.1:10086/ 打开的看板能放行、放弃队列里的任务（都转给 review-task）。
       只监听 127.0.0.1；挂了 launchd 会拉起。静态的 ~/.review/board.html 仍由 dev.herdsman.review-board 每 30 秒生成，
       服务不在时照常能看，只是没有按钮。install.sh 把 __HOME__ 换成家目录并加载。 -->
  <key>Label</key><string>dev.herdsman.review-board-serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/review-board</string>
    <string>serve</string>
    <string>--port</string>
    <string>10086</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/.review/board-serve.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.review/board-serve.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
