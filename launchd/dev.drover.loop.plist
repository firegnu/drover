<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.drover.loop</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/drover</string>
        <string>loop</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.drover/loop.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.drover/loop.stderr.log</string>
</dict>
</plist>
