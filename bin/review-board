  var st={};try{st=JSON.parse(sessionStorage.rb||'{}');sessionStorage.removeItem('rb')}catch(e){}
  // 地址栏里的锚点只在你点开或打开链接时跳；自动刷新时不跳，否则每 30 秒都被拽回那一条
  if(location.hash.length>1&&!st.auto){var t=document.getElementById(decodeURIComponent(location.hash.slice(1)));
    var pn=t&&t.closest('.panel');if(pn){pick=pn.dataset.p;setTimeout(function(){hit(t.id)},30)}}
