#!/usr/bin/env python3
"""drover-board —— 外层循环的看板，一个 curses TUI。

读 ~/.drover/projects 里登记过的仓库，从各自的交接目录（HANDOFF_DIR）算出每个项目的队列、
当前这件活、完成判据，画在终端里。不存任何自己的状态，**刷新等于重跑**；不接 agent，只问
corral 要状态。推进靠按键，不靠敲命令——按下去的每一个写操作都转给 bin/drover，判据和队列
的解析只能有一份实现。

用法:
  drover board                 打开看板
  drover board --projects F    改用 F 当项目清单（一行一个）；测试用

按键:
  ↑ ↓ / j k  选项目      g  放行（drover go）        n  发下一件（drover next）
  p  暂停 / 恢复         a  加任务（$EDITOR 编 queue.md）
  l  循环开 / 关         r  刷新                     q  退出

这个文件同时是 drover 的**数据模块**：bin/drover 和几个测试都 import 它，交接文件的解析、
完成判据的核对、外层循环的一跳（loop_tick）都在这里，两边用同一套。

以前这里还有一整层网页：静态 HTML、本机 HTTP 服务、令牌、Host / Origin 校验、页面 JS，
约 800 行。改 TUI 时整个删掉了（理由见 ROADMAP「看板」一节）——corral 已经有自己的 board，
drover 这边只需要一个不占分栏、能走 SSH 的任务看板。要查当初怎么写的，git log 全在。

项目发现: ~/.drover/projects，一行一个仓库路径，drover init 会写进去。不扫目录。
"""
import curses
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import unicodedata
from datetime import datetime

PROJ_LIST = os.path.expanduser("~/.drover/projects")
NOW = time.time()


# ============================================================ 读文件 / git
def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return None


def git(repo, *args):
    try:
        return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, timeout=30).stdout
    except Exception:
        return ""


_AGENTS = None

# corral 只用三个命令：send / status / ls。契约见 ~/Developer/personal_projs/corral/docs/CONTRACT.md。
# 不用 corral read：契约里写死了「没有终端模拟，agent 重绘时文字会乱，只作排查用，不要解析」。
# 「正在调什么工具 / 这一轮多久」改用 status 的 last_tool + turn_started，那是结构化字段。
CORRAL = os.environ.get("DROVER_CORRAL_BIN", "corral")
# 契约「退出码」一节：0 ok，2 不存在，3 送了没确认，4 超时，7 不是 idle，8 最近 30 秒有人在打字。
CORRAL_NOT_FOUND, CORRAL_NOT_DELIVERED, CORRAL_NOT_IDLE, CORRAL_HUMAN_ACTIVE = 2, 3, 7, 8


def corral(*args, timeout=10):
    """跑一条 corral 命令 → (退出码, JSON dict)。契约：每条命令在标准输出写一行 JSON。
    corral 不在、超时、输出不是 JSON，都当作「查不到」返回 (None, {})，不能把看板弄崩。"""
    try:
        r = subprocess.run([CORRAL, *args], capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None, {}
    try:
        return r.returncode, json.loads(r.stdout.strip().splitlines()[-1])
    except Exception:
        return r.returncode, {}


def corral_agents():
    """`corral ls` 一次，全页共用；corral 不在就是空列表。"""
    global _AGENTS
    if _AGENTS is None:
        _, j = corral("ls")
        _AGENTS = j.get("agents") or []
    return _AGENTS


def corral_status(name):
    """`corral status <名字>`；查不到返回 None。"""
    if not name:
        return None
    code, j = corral("status", name)
    return j if code == 0 and j.get("ok") else None


# 这里曾经有 repo_dirs() 和 crew_of()：把 `corral ls` 报的 cwd 顺着 `git worktree list` 映射回
# 项目，算出「这件活派出去了哪几个 agent」。**删掉了**：corral 的 board + --viewer 已经把「谁在忙、
# 在调什么工具、卡住没有、接入去看」做完了，而且比这里准——drover 只能靠 worktree 路径反推归属。
# drover 是任务看板，不是 agent 看板。要找回来看 git log。
def agents_of(repo, main_agent=""):
    """{"writer": info}：主控。配了 MAIN_AGENT 就按名字问 corral status（权威）；
    没配就退回「cwd 是这个仓库的 agent」——项目还没接上 corral 时看板照样能显示点东西。"""
    st = corral_status(main_agent)
    if st is None and not main_agent:
        real = lambda x: os.path.realpath(x) if x else ""
        hit = next((a for a in corral_agents() if real(a.get("cwd")) == real(repo)), None)
        st = corral_status(hit.get("name")) if hit else None
    if st is None:
        return {}
    return {"writer": {"status": st.get("state") or "unknown", "name": st.get("name", ""),
                       # 后两个只给「等人」的识别用，见 wants_human；title / kind / instance / activity
                       # 随主控状态块一起删了——那些是 corral board 的活
                       "idle_for": st.get("idle_for") or 0, "src": st.get("last_input_source", "")}}


def dur(sec):
    """一段时长 → 给人看的短写法。看板上所有时长都走这里，**只有这一套口径**：
    不满一分钟写秒（任务的耗时可能真就几十秒，写成 0m 等于没说）。"""
    d = max(0, int(sec))
    if d < 60:
        return f"{d}s"
    if d < 3600:
        return f"{d // 60}m"
    if d < 86400:
        return f"{d // 3600}h{(d % 3600) // 60:02d}m"
    return f"{d // 86400}d"


def ago(ts):
    return dur(NOW - ts) if ts else ""


# ============================================================ 解析交接文件
def parse_conf(path):
    """.drover.conf → {键: 值}。`#` 开头的行不匹配，天然当注释跳过。
    HANDOFF_DIR 是人可能手写的路径，`~` 在这里统一展开，下面各处就不用再管。"""
    conf = {}
    for line in (read(path) or "").splitlines():
        m = re.match(r'\s*([A-Z_]+)=(.*)', line)
        if m:
            conf[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    if conf.get("HANDOFF_DIR"):
        conf["HANDOFF_DIR"] = os.path.expanduser(conf["HANDOFF_DIR"])
    return conf



# ============================================================ 项目状态

IDLE_SETTLE = 120       # idle 多久才算「停下了」。每一轮结束都会短暂 idle，得留一次观察间隔


def attach_hint(name):
    """「等你」的每一条都带上怎么去看——人看到横幅，下一步就是接入那个 agent。
    drover 自己**不跑** attach（只用 send / status / ls），这只是一句给人抄的话。"""
    return f"去看看：corral attach {name}" if name else "去主控那边看看"


def wants_human(p):
    """「它在等人」：主控 idle 了，但这件活的判据还没满足——它停在某处等人拍板
    （审查复核没过、和审查者有分歧、要推送、要花钱、发现设计对不上）。→ 没满足的那几条，或 []。

    三种情况不算，都会误报：
      - corral 契约：`idle` **只表示这一轮结束，不代表 agent 不会再动**，它可能自己开新一轮
        （后台命令跑完自注入），契约提示看 `last_input_source`。是 `agent` 就不是在等人。
      - 每一轮结束都会短暂 idle，所以要 idle 够久（IDLE_SETTLE）才下结论。
      - `state` 是 `unknown`（不认识的 agent，没有钩子）时状态无从得知：**不猜**，
        让它照常显示，人自己去看。
    判据第 3 条不在这里跑（可能是整套测试，页面 30 秒一刷），只看纯 git 的前两条。"""
    a = (p.get("agents") or {}).get("writer")
    tv = p.get("tasks")
    if not a or not tv or not tv.get("card") or tv.get("awaiting"):
        return []
    if a["status"] != "idle" or a.get("src") == "agent" or (a.get("idle_for") or 0) < IDLE_SETTLE:
        return []
    rows = [find_done_mark(p["repo"], tv["card"].get("main", ""), p.get("done_mark", ""))] + \
        criteria(p["repo"], tv["card"].get("main", ""),
                 task_check_cmd(tv["card"].get("body"), p.get("check_cmd", "")), do_check=False)
    return [r for r in rows if r["ok"] is False]


def add_waits(p):
    """把「等你」补全：主控停下等人、以及队列做完等放行。

    「主控卡在审批对话框」那条删了：corral 的 board 本来就把 blocked 显在最显眼处，drover 跟着报
    一遍只是重复造轮子。留下的这两条都是只有 drover 算得出来的。"""
    new = []
    unmet = wants_human(p)
    if unmet:
        card = p["tasks"]["card"]
        why = "；".join(f'{r["name"]}：{r["why"]}' for r in unmet)
        new.append(("stop", "", "idle", "", f'{card["id"]} {card["title"]}：主控空闲着，但这件活的判据还没满足（{why}）。'
                                            f'{attach_hint((p.get("agents") or {}).get("writer", {}).get("name", ""))}'))
    tv = p.get("tasks")
    if tv and tv["awaiting"] and tv["card"]:
        new.append(("release", "", "", "", f"{tv['awaiting']} {tv['card']['title']} 做完了，核对已通过。"
                    "运行 drover go 放行，下一件会自动送进主控"))
        p["state"] = "等你放行"
    if new:
        p["human"].extend(new)
        p["needs_me"] = True
        if not p["waiting"]:
            p["waiting"] = "等你"



# ============================================================ 任务队列（drover 与看板共用这份解析）
TASK_HDR = re.compile(r'^##\s+(?:(T\d+)\s+)?(.+?)\s*$')


def task_blocks(text):
    """queue.md → [{id 或 None, title, body}]，按文件顺序。「## T7 标题」或「## 标题」开一块，第一块之前的行忽略。"""
    blocks, cur = [], None
    for line in (text or "").splitlines():
        m = TASK_HDR.match(line)
        if m:
            cur = {"id": m.group(1), "title": m.group(2), "body": []}
            blocks.append(cur)
        elif cur is not None:
            cur["body"].append(line)
    for b in blocks:
        b["body"] = "\n".join(b["body"]).strip("\n")
    return blocks


TASK_HOLD_LINE = re.compile(r'^\s*做完\s*[:：]\s*等我放行\s*$', re.M)
# 正文里的「验收：<命令>」覆盖 .drover.conf 的 CHECK_CMD（完成判据第 3 条）。
# 它会被当成 shell 命令跑，所以只认 queue.md 里写的：人自己编的文件，不经任何表单。
TASK_CHECK = re.compile(r'^\s*验收\s*[:：]\s*(\S.*?)\s*$', re.M)


def task_check_cmd(body, default=""):
    """正文里那行「验收：<命令>」→ 命令；没写就用传进来的默认值（.drover.conf 的 CHECK_CMD）。"""
    m = TASK_CHECK.search(body or "")
    return m.group(1) if m else default


# 正文里那行「任务文件：<相对路径>」，和上面的「验收：」同一套机制：人自己在 queue.md 里写的。
TASK_FILE = re.compile(r'^\s*任务文件\s*[:：]\s*(\S.*?)\s*$', re.M)
# 任务文件开头那行「路由：<档> / 交叉审查<要|不要>（路由：…；推翻：…）」。这是主控**本来就会写**
# 的一行（corral-dispatch 的 SKILL.md 第 3 节规定的记录格式），drover 只读、只显示。
TASK_ROUTE = re.compile(r'^\s*路由\s*[:：]\s*([^/（(]+?)\s*/\s*交叉审查\s*(不要|要)(?:\s*[（(](.*)[）)])?')
TASK_OVERRIDE = re.compile(r'推翻\s*[:：]\s*(.*)')
# 「推翻：无」后面主控常接着写别的话（把没推翻的理由也记在这一段里），只看开头那两个字
TASK_NO_OVERRIDE = re.compile(r'^(?:无|没有)(?:[。；;.、,，]|$)')
ROUTE_HEAD = 20         # 只看任务文件开头这些行：正文里举例子、引用格式的地方不算数


def task_files(repo, body, title, task_dir):
    """这件活的任务文件候选，按优先顺序 → [绝对路径]。两条路：

      1. 队列条目正文里写了「任务文件：<相对路径>」就**只认它**（和「验收：」同一套机制），
         不再往下走前缀匹配——它没有那一行就是没有；
      2. 没写，就是 TASK_FILE_DIR 里文件名以队列条目标题开头的那些 .md，按文件名排序。

    第 2 条给的是一串而不是一个：同一个前缀底下常常不止一份（交叉审查、审查意见都跟着任务
    同名开头，真实的 docs/任务/ 里就有），排序第一的那份未必是任务文件本身。挑哪一份由
    task_route 定——它挑第一份真带「路由：」行的。"""
    m = TASK_FILE.search(body or "")
    if m:
        p = os.path.join(repo, os.path.expanduser(m.group(1)))
        return [p] if os.path.isfile(p) else []
    if not task_dir or not title:
        return []
    d = os.path.join(repo, os.path.expanduser(task_dir))
    try:
        return [os.path.join(d, n) for n in sorted(os.listdir(d))
                if n.endswith(".md") and n.startswith(title)]
    except OSError:
        return []


def route_line(path):
    """一份任务文件开头那行「路由：…」→ {"tier": 档位, "cross": 要不要交叉审查,
    "overridden": 主控推翻没有}；没有那一行、读不了、编码坏了都是 None。"""
    try:
        with open(path, encoding="utf-8") as f:
            head = [next(f, "") for _ in range(ROUTE_HEAD)]
    except Exception:
        return None
    for line in head:
        m = TASK_ROUTE.match(line)
        if not m:
            continue
        # 「推翻：无」和不写这一段都是没推翻；写了别的才算主控推翻了路由的结论
        why = TASK_OVERRIDE.search(m.group(3) or "")
        t = why.group(1).strip() if why else ""
        return {"tier": m.group(1), "cross": m.group(2) == "要",
                "overridden": bool(t) and not TASK_NO_OVERRIDE.match(t)}
    return None


def task_route(repo, body, title, task_dir):
    """这件活的路由：候选文件里第一份带「路由：」行的那一份怎么写的 → {tier, cross, overridden}，
    一份都挑不出来就 None（页面上这一项不显示）。

    **只进显示，绝不参与任何判断**（ROADMAP 待定 4）：不进完成判据、不进 wants_human、不进
    loop_tick 的任何分支。它依赖内循环的一个书写格式，算擦边，但不要求主控多做事；漏读只是
    少显示一项，不影响判完成——所以不需要收尾记号那条例外的三条支撑。

    降级是硬要求：没配 TASK_FILE_DIR、目录不在、文件找不到、没有那一行、格式对不上、编码坏了
    ——一律返回 None，一个异常都不许漏出去，看板不能因为一行文案崩掉。"""
    try:
        return next((r for r in (route_line(p) for p in task_files(repo, body, title, task_dir)) if r), None)
    except Exception:
        return None


def task_holds(evs):
    """tasks.state 里的 hold 事件 → 打着「做完停」的任务 key 集合（有编号按编号，没编号按标题；后来的事件覆盖前面的）。"""
    on = {}
    for e in evs:
        if e.get("ev") == "hold" and e.get("key"):
            on[e["key"]] = bool(e.get("on"))
    return {k for k, v in on.items() if v}


def task_held(t, holds):
    """这个任务做完要不要停下等放行：看板上点了「做完停」，或正文里写了「做完：等我放行」。t 可以是队列块或 tasks.state 里的任务。"""
    keys = {t.get("id"), t.get("key") or t.get("title")} - {None, ""}
    return bool(keys & holds) or bool(TASK_HOLD_LINE.search(t.get("body") or ""))


def queue_version(text):
    """queue.md 内容的短指纹：页面记下它，改顺序 / 改任务时带回来，对不上说明这期间队列被别人改过。"""
    return hashlib.sha1((text or "").encode("utf-8")).hexdigest()[:12]


def task_events(text):
    out = []
    for line in (text or "").splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out


def task_fold(evs):
    """tasks.state 的事件 → ({id: task}（按开始顺序）, 进行中的那个, 在等放行的 id)。"""
    tasks, awaiting = {}, None
    for e in evs:
        tid, ev = e.get("id"), e.get("ev")
        if ev == "start":
            tasks[tid] = {"id": tid, "title": e.get("title", ""), "body": e.get("body", ""), "key": e.get("key", ""),
                          "start": e.get("sha", ""), "main": e.get("main", ""), "t0": e.get("t"), "status": "doing"}
            awaiting = None
        elif ev == "done" and tid in tasks:
            tasks[tid].update(status="done", end=e.get("sha", ""), t1=e.get("t"))
            awaiting = tid if e.get("gate") else None
        elif ev == "drop":
            t = tasks.setdefault(tid, {"id": tid, "title": e.get("title", ""), "body": "", "key": e.get("key", ""), "start": ""})
            t.update(status="dropped", reason=e.get("reason", ""), t1=e.get("t"))
        elif ev == "go":
            if tid in tasks:
                tasks[tid]["t2"] = e.get("t")     # 放行的时刻。「等放行时长」= t2 - t1，只有放行模式才有
            awaiting = None
    current = next((t for t in tasks.values() if t["status"] == "doing"), None)
    return tasks, current, awaiting


def task_pending(blocks, tasks):
    """队列里还没开始的块，按文件顺序。有编号按编号认，没编号按标题认（所以开始过的任务别改标题）。"""
    keys = {t["key"] for t in tasks.values() if t.get("key")}
    return [b for b in blocks if not (b["id"] in tasks if b["id"] else b["title"] in keys)]


def task_commits(repo, a, b):
    return git(repo, "rev-list", f"{a}..{b}").split() if a and b and a != b else []


# ============================================================ 完成判据（只读核对 git）
MAIN_BRANCH = "main"
CHECK_TIMEOUT = 1800        # 验收命令的上限；跑过头当作不过，不能把 drover 卡住


def task_branches(repo, base_sha):
    """所有本地分支 → (包含 base_sha 的本次分支, 排除的遗留分支, 查询错误)。main 自己永远不算。"""
    out = git(repo, "branch", "--list", "--format=%(refname:short)").splitlines()
    current, excluded, errors = [], [], []
    for b in (b.strip() for b in out):
        if not b or b == MAIN_BRANCH:
            continue
        result = subprocess.run(
            ["git", "-C", repo, "merge-base", "--is-ancestor", base_sha, b],
            capture_output=True, text=True)
        if result.returncode == 0:
            current.append(b)
        elif result.returncode == 1:
            excluded.append(b)
        else:
            errors.append(f"{b} 查询失败（git 退出码 {result.returncode}）：{result.stderr.strip()}")
    return current, excluded, errors


def run_check(repo, cmd):
    """跑验收命令 → (退出码, 输出尾巴)。过 shell（CHECK_CMD 里会有 && 和管道），在仓库根跑。
    命令跑不起来（127）和测试没通过（非 0）都是不过，但退出码会照原样报出来，好分辨是哪一种。"""
    try:
        r = subprocess.run(cmd, shell=True, cwd=repo, capture_output=True, text=True, timeout=CHECK_TIMEOUT)
    except subprocess.TimeoutExpired:
        return None, f"超过 {CHECK_TIMEOUT} 秒还没跑完"
    tail = "\n".join((r.stdout + r.stderr).strip().splitlines()[-8:])
    return r.returncode, tail


def criteria(repo, base_sha, check_cmd, do_check=True):
    """三条完成判据的只读核对 → [{n, name, ok, why}]。
    ok 为 True / False / None，None 表示这条不适用（既不算过，也不算不过）。
    全程只读：只跑 rev-parse / branch --list / merge-base，外加人自己配的验收命令。

    `do_check=False` 时第 3 条不跑命令、直接标「没查」。**渲染页面时必须用这个**：第 3 条
    可能是整套测试，页面 30 秒刷一次、每个项目都渲染，等于每半分钟把所有项目的测试跑一遍。
    前两条是纯 git，便宜，渲染时照算——「等人」的识别靠的就是它们（见 wants_human）。"""
    rows = []

    head = git(repo, "rev-parse", MAIN_BRANCH).strip()
    if not head:
        rows.append({"n": 1, "name": f"{MAIN_BRANCH} 前进了", "ok": False,
                     "why": f"仓库里没有 {MAIN_BRANCH} 分支，判据无从谈起"})
    else:
        moved = bool(base_sha) and head != base_sha
        rows.append({"n": 1, "name": f"{MAIN_BRANCH} 前进了", "ok": moved,
                     "why": (f"{base_sha[:7]} → {head[:7]}" if moved else
                             f"还停在 {head[:7]}，送任务之后没有前进" if base_sha else
                             "没有记下送任务之前的 sha，没法比")})

    name2 = "这次建的分支都合进去了"
    if not base_sha:
        rows.append({"n": 2, "name": name2, "ok": None,
                     "why": "没有 base_sha：没记下送任务之前的 sha，无法判断哪些分支是这次的"})
    else:
        brs, excluded, errors = task_branches(repo, base_sha)
        if errors:
            rows.append({"n": 2, "name": name2, "ok": False, "why": "\n".join(errors)})
        elif not brs:
            # 合并后删掉分支是正常收尾；遗留分支仍逐个列出，便于核对排除是否合理。
            rows.append({"n": 2, "name": name2, "ok": True,
                         "why": (f"{len(excluded)} 个分支全部被排除（不包含 base_sha，按遗留分支处理）："
                                 + "、".join(excluded)) if excluded else
                                "没有未合并的分支"})
        else:
            left = [b for b in brs
                    if subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", b, MAIN_BRANCH],
                                      capture_output=True).returncode != 0]
            rows.append({"n": 2, "name": name2, "ok": not left,
                         "why": (f"{len(brs)} 个都已经是 {MAIN_BRANCH} 的祖先：" + "、".join(brs)) if not left
                                else f"还没合进 {MAIN_BRANCH}：" + "、".join(left)})
        if excluded and (brs or errors):
            rows[-1]["why"] += "；已排除不包含 base_sha 的遗留分支：" + "、".join(excluded)

    name3 = "验收命令过了"
    if not check_cmd:
        rows.append({"n": 3, "name": name3, "ok": None, "why": "没有验收命令：CHECK_CMD 空着，队列条目也没写"})
    elif not do_check:
        rows.append({"n": 3, "name": name3, "ok": None, "why": f"`{check_cmd}` 没在刷新时跑（可能是整套测试）；drover done 时才跑"})
    else:
        code, tail = run_check(repo, check_cmd)
        rows.append({"n": 3, "name": name3, "ok": code == 0,
                     "why": f"`{check_cmd}` " + ("过了" if code == 0 else
                                                 tail if code is None else
                                                 f"退出码 {code}" + (f"\n{tail}" if tail else ""))})
    return rows


def find_done_mark(repo, base_sha, mark):
    """收尾记号 → {n, name, ok, why}，形状和 criteria 的每一条一样。

    这是判「这件活完了」的**唯一依据**，上面三条是门（见 ROADMAP 完成判据那一节）。
    主控收尾时在 main 上打一条空提交，首行「<前缀>: 一句话」；约定写在项目自己的
    AGENTS.md 里（来源是 corral 的 项目AGENTS模板.md），drover 只认 git，不去读那份文字。

    四道闸：

      1. 区间  只在 base_sha..MAIN_BRANCH 里找。上一件活的记号进不来。
      2. 单亲  父提交恰好一个。**这道不是锦上添花**：不给 -m / -c 时 git 对合并提交默认
               不出 diff，所以合并提交在 diff-tree 眼里输出也是 0 行（验过）。主控哪天
               在合并摘要里恰好写了前缀开头，光靠「空 + 前缀」就会误判。
      3. 空    一个文件都没改。
      4. 前缀  首行 `^<前缀>` 加冒号，全角半角都收（人手敲中文容易出全角）。

    mark 留空 = 这个项目不打收尾记号 → ok=None（不适用）。这时判不出完成，循环开着也
    不自动记 done，退回等人放行。"""
    name = "收尾记号"
    if not mark:
        return {"n": 0, "name": name, "ok": None,
                "why": "没配 DONE_MARK：这个项目不打收尾记号，判不出这件活完没完"}
    if not base_sha:
        return {"n": 0, "name": name, "ok": False, "why": "没有记下送任务之前的 sha，划不出区间"}

    pat = re.compile(r"^" + re.escape(mark) + r"\s*[:：]")
    for line in git(repo, "log", "--format=%H%x09%s", f"{base_sha}..{MAIN_BRANCH}").splitlines():
        sha, _, subject = line.partition("\t")
        if not pat.match(subject):
            continue
        if len(git(repo, "rev-list", "--parents", "-n1", sha).split()) != 2:   # 自己 + 恰好一个父
            continue
        if git(repo, "diff-tree", "--no-commit-id", "--name-only", "-r", sha).strip():
            continue
        return {"n": 0, "name": name, "ok": True, "why": f"{sha[:7]} {subject}"}
    return {"n": 0, "name": name, "ok": False,
            "why": f"{base_sha[:7]}..{MAIN_BRANCH} 里没有「{mark}: 」开头的空提交"}


def task_span(a, b):
    """两个时刻之间有多久。缺一头就不显示——写成 0 会被当成「真的是 0」。"""
    return dur(b - a) if a and b else ""


def task_view(repo, conf, p):
    """任务区要显示的东西。项目没有 queue.md（没用队列）就返回 None，页面上不出现任务区。"""
    d = conf["HANDOFF_DIR"]
    qtext = read(f"{d}/queue.md")
    if qtext is None:
        return None
    task_dir = conf.get("TASK_FILE_DIR", "")       # 找任务文件读「路由：」行用的，纯显示
    tasks, current, awaiting = task_fold(task_events(read(f"{d}/tasks.state")))
    t = current or tasks.get(awaiting)
    card = None
    if t:
        commits = task_commits(repo, t["start"], t.get("end") or p["head"])
        now = "收尾" if t["id"] == awaiting else "实施"
        n = len(commits)
        steps = [
            ("实施", "now" if now == "实施" else "ok", f"{n} 个提交" if n else "—"),
            ("收尾", "now release" if now == "收尾" else "", "核对通过 · 等你放行" if now == "收尾" else "drover done"),
        ]
        # 分支进展：从发任务那一刻的 main 算起，main 上多了几个提交、最后一次多久前。
        # 纯 git，便宜；判据第 1 条看的也是这个 sha，两处说的是同一件事。
        base = t.get("main", "")
        on_main = task_commits(repo, base, MAIN_BRANCH) if base else []
        last_at = int(git(repo, "log", "-1", "--format=%ct", MAIN_BRANCH).strip() or 0) if on_main else 0
        card = {"id": t["id"], "title": t["title"], "start": t["start"], "main": base,
                "on_main": len(on_main), "last_at": last_at,
                "commits": n, "steps": steps, "body": t.get("body", ""),
                "held": task_held(t, task_holds(task_events(read(f"{d}/tasks.state")))),
                "waiting": now == "收尾", "span": task_span(t.get("t0"), t.get("t1") or NOW),
                # 任务文件开头那行「路由：…」，只显示，不参与任何判断；读不出来就是 None
                "route": task_route(repo, t.get("body", ""), t.get("title", ""), task_dir)}
    finished = []
    for f in reversed([x for x in tasks.values() if x["status"] != "doing" and x["id"] != awaiting][-5:]):
        if f["status"] == "dropped":
            finished.append({"id": f["id"], "title": f["title"], "dropped": True, "reason": f.get("reason", ""), "body": f.get("body", "")})
            continue
        # 记账三项（ROADMAP 待定 3）：耗时、提交数、等放行时长。全部从现有事件流和 git 算，
        # 不加新事件。**「返工轮数」不做**——drover 看不见主控和 dev agent 之间的往返（硬规矩
        # 第 4 条），记不出来；提交数就叫提交数，不冒充它。
        finished.append({"id": f["id"], "title": f["title"], "dropped": False, "span": task_span(f.get("t0"), f.get("t1")),
                         "commits": len(task_commits(repo, f.get("start"), f.get("end"))),
                         "wait": task_span(f.get("t1"), f.get("t2")),   # 自动模式没有 go 事件：这一项没有，不是 0
                         # 路由也记进来（待定 3 列的记账内容里就有「路由判了什么 / 推翻没有」）
                         "route": task_route(repo, f.get("body", ""), f.get("title", ""), task_dir),
                         "body": f.get("body", ""),
                         "range": f"{f['start'][:7]}..{f['end'][:7]}" if f.get("end") and f["end"] != f["start"] else ""})
    try:
        loop_wait = json.loads(read(f"{d}/.loop-wait") or "null")
    except ValueError:
        loop_wait = None
    return {"dir": d, "todo": task_pending(task_blocks(qtext), tasks), "card": card, "finished": finished, "qv": queue_version(qtext),
            "loop": os.path.exists(f"{d}/loop"), "loop_wait": loop_wait if isinstance(loop_wait, dict) else None,
            "holds": task_holds(task_events(read(f"{d}/tasks.state"))),
            "awaiting": awaiting, "gate": conf.get("TASK_GATE", "1").strip() != "0", "paused": os.path.exists(f"{d}/paused"),
            "done": sum(x["status"] == "done" for x in tasks.values()),
            "dropped": sum(x["status"] == "dropped" for x in tasks.values())}


def project_state(repo, conf):
    d = conf["HANDOFF_DIR"]
    p = {"name": os.path.basename(repo), "repo": repo, "dir": d,
         "head": git(repo, "rev-parse", "HEAD").strip(),
         "state": "空闲", "since": None, "waiting": "", "needs_me": False, "human": []}
    p["last_activity"] = max([mtime(f"{d}/{f}") or 0 for f in os.listdir(d)] or [0]) if os.path.isdir(d) else 0
    p["main_agent"] = conf.get("MAIN_AGENT", "")
    p["done_mark"] = conf.get("DONE_MARK", "收尾").strip()
    p["check_cmd"] = conf.get("CHECK_CMD", "")
    p["agents"] = agents_of(repo, p["main_agent"])
    p["tasks"] = task_view(repo, conf, p)
    add_waits(p)
    return p


# ============================================================ 项目发现
def discover(list_path):
    """只认登记过的仓库：~/.drover/projects 一行一个（drover-init 会写进去）。
    不扫目录——「哪个目录下多了个 .drover.conf 就自动接进来」听着方便，实际是让看板去够它没被告知的东西。"""
    repos = []
    for line in (read(list_path or PROJ_LIST) or "").splitlines():
        line = os.path.expanduser(line.strip())
        if line and not line.startswith("#") and os.path.isfile(f"{line}/.drover.conf"):
            repos.append(line)
    seen, out = set(), []
    for r in sorted(set(repos)):
        real = os.path.realpath(r)
        if real not in seen:
            seen.add(real); out.append(r)
    return out


def collect(list_path):
    """各项目的当前状态。看板每刷新一次就整个重跑一遍——不存状态，刷新等于重跑。
    NOW 每次重取：看板是常驻前台进程，停在启动那刻的 NOW 会让「几分钟前」「已进行多久」越来越偏。"""
    global NOW, _AGENTS
    NOW, _AGENTS = time.time(), None                 # corral 的 agent 列表同理：每页重查
    projects = []
    for repo in discover(list_path):
        conf = parse_conf(f"{repo}/.drover.conf")
        if "HANDOFF_DIR" not in conf:
            continue
        projects.append(project_state(repo, conf))
    # 同名仓库（不同目录下的同名 checkout）用上一级目录区分，name 是页面里的唯一键
    names = [p["name"] for p in projects]
    for p in projects:
        if names.count(p["name"]) > 1:
            p["name"] = os.path.basename(os.path.dirname(p["repo"])) + "/" + p["name"]
    projects.sort(key=lambda p: (not p["needs_me"], -(p["since"] or p["last_activity"] or 0), p["name"]))
    return projects


# ============================================================ 显示宽度
def cell(c):
    """一个字符在终端里占几格：东亚宽字符（W / F）两格，组合字符（声调符号之类）不占格。"""
    return 0 if unicodedata.combining(c) else (2 if unicodedata.east_asian_width(c) in ("W", "F") else 1)


def width(s):
    """字符串占几格。curses 按字符数排版会错位：「把 CSS 导入改成流式」是 12 个字符、19 格。
    所有排版都得过这里，一开始就算对，不然满屏是歪的。"""
    return sum(cell(c) for c in s)


def trunc(s, n):
    """截到显示宽度不超过 n 格；截过就以 … 结尾（… 占 1 格）。"""
    if n <= 0:
        return ""
    if width(s) <= n:
        return s
    out, w = [], 0
    for c in s:
        if w + cell(c) > n - 1:
            break
        out.append(c)
        w += cell(c)
    return "".join(out) + "…"


# ============================================================ view_model：要显示什么
def health():
    """顶栏那句健康提示。数据源只剩 corral —— launchd 托管、静态页多久没刷、服务跑的是不是
    旧代码，那几项跟着网页层一起删了：看板现在是你自己开的前台进程，这些一眼就看得见。"""
    code, _ = corral("ls", timeout=3)
    return {"ok": code == 0,
            "text": "corral 正常" if code == 0 else "corral 连不上：主控状态显示不出来，任务也送不出去"}


def wait_items(p):
    """「等你」的条目 → [(去重用的 key, 给人看的一句话)]。看板和系统通知共用，两边说的是同一件事。"""
    return [(f"{p['name']}|{kind}|{fid}|{verb}|{sev}|{reason}",
             f"STOP · {reason}" if kind == "stop" else reason)
            for kind, fid, verb, sev, reason in p["human"]]


def card_vm(p, tv):
    """「当前这件活」：分支进展 + 判据过了几条。**依据（收尾记号）排最前**，三条门跟在后面。

    第 3 条不在这里跑（`do_check=False`）：它可能是整套测试，而看板每刷新一次就要算一遍。
    前两条是纯 git，便宜，照算。"""
    c = tv["card"]
    if not c:
        return None
    rows = [find_done_mark(p["repo"], c["main"], p.get("done_mark", ""))] + \
        criteria(p["repo"], c["main"],
                 task_check_cmd(c.get("body"), p.get("check_cmd", "")), do_check=False)
    last = ago(c["last_at"])
    return {"id": c["id"], "title": c["title"], "waiting": c["waiting"], "held": c["held"],
            "span": c["span"], "commits": c["commits"], "on_main": c["on_main"], "route": c["route"],
            # 分支进展：从发任务那一刻的 main 算起，main 上多了几个提交、最后一次多久前。
            # 判据第 1 条看的是同一个 sha，两处说的是同一件事。
            "progress": (f'{MAIN_BRANCH} 上 {c["on_main"]} 个提交' + (f'，最后一次 {last} 前' if last else ""))
                        if c["on_main"] else f"{MAIN_BRANCH} 上 0 个提交，还没有提交落地",
            "criteria": [{"name": r["name"], "ok": r["ok"], "why": r["why"]} for r in rows],
            "met": f'{sum(1 for r in rows if r["ok"] is True)}/{sum(1 for r in rows if r["ok"] is not None)}'}


def queue_vm(p, tv):
    c = tv["card"]
    return {"mode": "暂停中" if tv["paused"] else "循环中" if tv["loop"] else "放行模式" if tv["gate"] else "自动模式",
            "loop": tv["loop"], "paused": tv["paused"], "gate": tv["gate"], "awaiting": tv["awaiting"],
            "counts": {"todo": len(tv["todo"]), "doing": 1 if c and not c["waiting"] else 0,
                       "done": tv["done"], "dropped": tv["dropped"]},
            "card": card_vm(p, tv),
            "todo": [{"id": b["id"] or "", "title": b["title"], "next": i == 0,
                      "held": task_held(b, tv["holds"])} for i, b in enumerate(tv["todo"])],
            "finished": [{"id": f["id"], "title": f["title"], "dropped": f["dropped"],
                          "reason": f.get("reason", ""), "span": f.get("span", ""), "range": f.get("range", ""),
                          "commits": f.get("commits", 0), "wait": f.get("wait", ""), "route": f.get("route")}
                         for f in tv["finished"]]}


def project_vm(p):
    tv = p.get("tasks")
    return {"name": p["name"], "repo": p["repo"], "dir": p["dir"], "head": p["head"][:7],
            "state": p["state"], "waiting": p["waiting"], "needs_me": p["needs_me"],
            # 按「谁在等」分档：me = 等你，wr = 等主控，none = 没人在等
            "badge": "me" if p["needs_me"] else ("wr" if p["waiting"] else "none"),
            "age": ago(p["since"]),
            "waits": [text for _, text in wait_items(p)],
            "queue": queue_vm(p, tv) if tv else None}


def view_model(projects):
    """看板要显示的一切，一份纯数据 —— 不碰 curses，也不管怎么画。

    分 view_model / draw 两层是为了能验：断言全打在这份字典上，比 grep 画面结实（换个排版、
    换个配色不会挂）。画那一层薄到只补一条「画进很窄的假屏幕不崩、不越界」的冒烟就够。"""
    return {"health": health(),
            "waits": [{"project": p["name"], "text": text, "age": ago(p["since"])}
                      for p in projects for _, text in wait_items(p)],
            "projects": [project_vm(p) for p in projects]}


# ============================================================ draw：怎么画
RAIL = 24            # 左边项目列表的宽度上限
COLORS = {}          # 样式名 → curses 属性。TUI 启动时填；没填（测试里画进假屏幕）就一律 0


def init_colors():
    """深色：只设前景色，背景交给终端自己（use_default_colors）。看板一直是深色的，不为浅色折中。"""
    try:
        curses.start_color()
        curses.use_default_colors()
    except curses.error:
        return
    for i, (kind, fg) in enumerate([("h1", curses.COLOR_WHITE), ("h2", curses.COLOR_CYAN),
                                    ("wait", curses.COLOR_RED), ("bad", curses.COLOR_RED),
                                    ("ok", curses.COLOR_GREEN), ("sel", curses.COLOR_YELLOW),
                                    ("dim", -1), ("line", -1)], start=1):
        try:
            curses.init_pair(i, fg, -1)
        except curses.error:
            continue
        COLORS[kind] = curses.color_pair(i)
    for kind in ("h1", "h2", "sel"):
        COLORS[kind] = COLORS.get(kind, 0) | curses.A_BOLD
    for kind in ("dim", "line"):
        COLORS[kind] = COLORS.get(kind, 0) | curses.A_DIM


def put(stdscr, y, x, text, h, w, kind=""):
    """写一行，截到屏幕里。右下角那一格 curses 写不得，最后一行少用一格。"""
    if y < 0 or y >= h or x < 0 or x >= w:
        return
    t = trunc(text, w - x - (1 if y == h - 1 else 0))
    if t:
        stdscr.addstr(y, x, t, COLORS.get(kind, 0))


def route_tier(rt):
    """档位写成「重档」「常规档」——主控写的就是「重」「常规」，补个「档」字读着顺。"""
    return rt["tier"] + ("" if rt["tier"].endswith("档") else "档")


def route_chip(rt):
    """路由缩成一个词：「重档」「常规档（推翻）」。没有路由就是空字符串，整项不出现。
    「做完的」是一行一件，写不下全的；全的在「当前这件活」里。"""
    return (route_tier(rt) + ("（推翻）" if rt["overridden"] else "")) if rt else ""


def detail_lines(pv):
    """选中项目的详情，从上到下：等你 → 当前这件活 → 队列 → 做完的。
    → [(样式, 缩进, 文字)]，draw 照着画就行。"""
    out = [("h1", 0, f'{pv["name"]}  {pv["state"]}  HEAD {pv["head"]}')]
    if pv["waits"]:
        out.append(("wait", 0, f'等你 · {len(pv["waits"])}'))
        out += [("wait", 2, f"· {t}") for t in pv["waits"]]
    q = pv["queue"]
    if not q:
        out.append(("dim", 0, "没接任务队列：交接目录里还没有 queue.md。按 a 写一个"))
        return out
    c = q["card"]
    out.append(("h2", 0, "当前这件活" + ("" if c else " · 空着")))
    if c:
        out.append(("", 2, " ".join(x for x in (c["id"], c["title"]) if x)))
        out.append(("dim", 2, f'{c["commits"]} 个提交 · 已进行 {c["span"]}'
                              + ("  · 核对通过，等你按 g 放行" if c["waiting"] else "")
                              + ("  · 做完停" if c["held"] else "")))
        out.append(("dim", 2, c["progress"]))
        if c["route"]:
            rt = c["route"]
            out.append(("dim", 2, f'路由 {route_tier(rt)} · 交叉审查{"要" if rt["cross"] else "不要"}'
                                  + ("  · 主控推翻了路由" if rt["overridden"] else "")))
        out.append(("", 2, f'判据 {c["met"]}'))
        for r in c["criteria"]:
            mark = "✓" if r["ok"] else ("–" if r["ok"] is None else "✗")
            out.append(("ok" if r["ok"] else ("dim" if r["ok"] is None else "bad"), 3,
                        f'{mark} {r["name"]}：{" ".join(r["why"].split())}'))
    out.append(("h2", 0, f'队列 · {q["counts"]["todo"]}   {q["mode"]}'))
    for i, t in enumerate(q["todo"]):
        out.append(("", 2, f'{i + 1}. ' + ("下一个 · " if t["next"] else "") + (f'{t["id"]} ' if t["id"] else "手写 ")
                           + t["title"] + ("  · 做完停" if t["held"] else "")))
    if not q["todo"]:
        out.append(("dim", 2, "空了。按 a 加任务"))
    out.append(("h2", 0, f'做完的 · {q["counts"]["done"]}'
                         + (f' · 放弃 {q["counts"]["dropped"]}' if q["counts"]["dropped"] else "")))
    for f in q["finished"]:
        # 记账：路由 · 耗时 · 提交数 · 等放行时长。一行一件，挤——路由缩到「档位（推翻）」两三个字，
        # 而且排在记账前面：窄屏截行是从尾巴截的，掉的先是三项里最不要紧的「等放行时长」。
        # 全须全尾的那份在「当前这件活」里（那里一件活占好几行，写得开）。
        acct = " · ".join(x for x in (route_chip(f["route"]), f["span"], f'{f["commits"]} 个提交',
                                      f'等放行 {f["wait"]}' if f["wait"] else "") if x)
        out.append(("dim", 2, f'{f["id"]} {f["title"]}  '
                              + (f'放弃：{f["reason"]}' if f["dropped"] else acct)))
    if not q["finished"]:
        out.append(("dim", 2, "还没有"))
    return out


def detail_viewport(total, room, offset, pages=0):
    """纯排版计算：溢出时留一行提示，先夹住旧偏移，再翻页；没有可视行就归零。"""
    page = max(0, room - (1 if total > room else 0))
    limit = max(0, total - page) if page else 0
    offset = min(max(0, offset), limit)
    return min(max(0, offset + pages * page), limit), page


def draw(stdscr, vm, state):
    """把 view_model 画出来；详情视口只写进内存 state，夹限交给纯函数。"""
    h, w = stdscr.getmaxyx()
    stdscr.erase()
    ps = vm["projects"]
    sel = min(max(state.get("sel", 0), 0), len(ps) - 1) if ps else 0
    project = ps[sel]["repo"] if ps else None
    lines = detail_lines(ps[sel]) if ps else [("dim", 0, "没有登记过的项目。到仓库里运行 drover init <短名>")]
    room = h - 3 if h >= 5 and w >= 20 else 0
    offset = state.get("detail_offset", 0) if state.get("detail_project") == project else 0
    offset, page = detail_viewport(len(lines), room, offset)
    state.update(detail_project=project, detail_offset=offset, detail_total=len(lines), detail_room=room)
    if h < 5 or w < 20:
        put(stdscr, 0, 0, "窗口太小", h, w)
        return
    head = f'drover · {len(ps)} 个项目 · {vm["health"]["text"]}' + (f' · 等你 {len(vm["waits"])}' if vm["waits"] else "")
    put(stdscr, 0, 0, head, h, w, "h1" if vm["health"]["ok"] else "bad")
    put(stdscr, 1, 0, "─" * w, h, w, "line")
    top, bot = 2, h - 2                                  # 正文占的行，含 bot
    rail = min(RAIL, max(12, w // 3))
    if w < rail + 16 or not ps:
        rail = 0                                         # 窄屏（或一个项目都没有）：只画详情
    if rail:
        rows = bot - top + 1
        first = max(0, min(sel - rows + 1, len(ps) - rows)) if len(ps) > rows else 0
        for i in range(first, min(len(ps), first + rows)):
            pv = ps[i]
            put(stdscr, top + i - first, 0,
                ("▸" if i == sel else " ") + ("●" if pv["needs_me"] else " ") + pv["name"],
                h, rail, "sel" if i == sel else ("bad" if pv["needs_me"] else ""))
        for y in range(top, bot + 1):
            put(stdscr, y, rail, "│", h, w, "line")
    x = rail + 2 if rail else 0
    shown = lines[offset:offset + page]
    for i, (kind, indent, text) in enumerate(shown):
        put(stdscr, top + i, x + indent, text, h, w, kind)
    if len(lines) > room:
        put(stdscr, bot, x, f"PgUp↑{offset} PgDn↓{len(lines) - offset - len(shown)}", h, w, "dim")
    put(stdscr, h - 1, 0, state.get("msg", ""), h, w, "dim")


# ============================================================ 按键
REFRESH_MS = 30000       # 没按键时多久自己刷一次。刷新等于重跑，看板不存自己的状态
HELP = "↑↓/jk 选项目 · PgUp/PgDn 翻详情 · g 放行 · n 发下一件 · p 暂停 · a 加任务 · l 循环 · r 刷新 · q 退出"


def run_drover(repo, *args):
    """所有写操作都转给 bin/drover —— 判据和队列的解析只能有一份实现，TUI 自己不动交接文件。
    → 给人看的一行（drover 的第一行输出，成了也好、拒了也好，它自己会说清楚）。"""
    try:
        r = subprocess.run([sys.executable, task_bin_path(), *args], cwd=repo,
                           capture_output=True, text=True, timeout=120)
    except Exception as e:
        return f"drover {' '.join(args)}：没跑起来（{e}）"
    out = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()]
    return out[0] if out else f"drover {' '.join(args)}：退出码 {r.returncode}"


def edit_queue(stdscr, pv):
    """加任务 = 拿 $EDITOR 编这个项目的 queue.md，关掉就生效。队列本来就是个 markdown 文件，
    在看板里重新实现一个文本编辑器没有意义（网页版那个带实时预览的编辑框正是那么长出来的）。"""
    path = os.path.join(pv["dir"], "queue.md")
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    curses.endwin()
    try:
        subprocess.call(f'{editor} "{path}"', shell=True)     # EDITOR 可能带参数，过一层 shell
    finally:
        stdscr.clear()
        stdscr.refresh()
        curses.curs_set(0)
    return f"编辑完 {path}"


def key_action(k, pv, state):
    """按了什么键 → 要做什么。**纯函数**：不碰 curses、不跑命令、不改 state。

    「推进靠按键，不靠敲命令」是看板的主操作面（ROADMAP），所以这一层和 view_model 一样
    单拆出来：喂键码就能验，尤其是 p 和 l ——它们按当前状态决定发哪一条，切反了就是真 bug。
    tui() 那边只剩 getch 和执行。

    state 里读 sel（选中第几个）、n（一共几个项目），以及 draw 当帧写入的详情视口。
    → ("sel", 新下标) | ("scroll", 新偏移) | ("run", [drover 的参数…]) | ("edit",) | ("quit",) | ("refresh",) | None
      None = 这个键不认识，或者压根没有选中的项目：什么都不做，**也不重跑**——重跑要跑一圈
      git 和 corral，不能乱按一下就触发。"""
    sel, n = state.get("sel", 0), state.get("n", 0)
    if k in (curses.KEY_UP, ord("k")):
        return ("sel", max(0, sel - 1))
    if k in (curses.KEY_DOWN, ord("j")):
        return ("sel", min(n - 1, sel + 1) if n else 0)
    if k == ord("q"):
        return ("quit",)
    if k in (ord("r"), -1, curses.KEY_RESIZE):                # -1 = getch 超时，没人按键，自己刷一次
        return ("refresh",)
    if not pv:
        return None
    if k in (curses.KEY_NPAGE, curses.KEY_PPAGE):
        offset, _ = detail_viewport(state.get("detail_total", 0), state.get("detail_room", 0),
                                    state.get("detail_offset", 0),
                                    1 if k == curses.KEY_NPAGE else -1)
        return ("scroll", offset)
    if k == ord("a"):
        return ("edit",)
    q = pv["queue"] or {}                                     # 没接队列的项目：当成没暂停、循环没开
    return {ord("g"): ("run", ["go"]),
            ord("n"): ("run", ["next"]),
            ord("p"): ("run", ["resume" if q.get("paused") else "pause"]),
            ord("l"): ("run", ["loop", "off" if q.get("loop") else "on"])}.get(k)


def tui(stdscr, list_path):
    curses.curs_set(0)
    init_colors()
    stdscr.timeout(REFRESH_MS)
    vm = view_model(collect(list_path))
    state = {"sel": 0, "n": len(vm["projects"]), "msg": HELP}
    while True:
        draw(stdscr, vm, state)
        stdscr.refresh()
        try:
            k = stdscr.getch()
        except KeyboardInterrupt:
            return
        ps = vm["projects"]
        pv = ps[min(state["sel"], len(ps) - 1)] if ps else None
        act = key_action(k, pv, state)
        if not act:
            continue
        if act[0] == "quit":
            return
        if act[0] == "sel":
            state["sel"] = act[1]
            continue
        if act[0] == "scroll":
            state["detail_offset"] = act[1]
            continue
        if act[0] == "edit":
            state["msg"] = edit_queue(stdscr, pv)
        elif act[0] == "run":
            state["msg"] = run_drover(pv["repo"], *act[1])
        else:
            state["msg"] = HELP                               # refresh：消息栏还原成按键提示
        vm = view_model(collect(list_path))                   # 刷新等于重跑
        state["n"] = len(vm["projects"])


# ============================================================ 外层循环的一跳
def task_bin_path():
    """和看板装在一起的那个 drover。两个工具必须成对，不然解析交接文件的函数对不上。"""
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "drover")


CHECK_EVERY = 300       # 两次完整核对之间至少隔这么久。第 3 条可能是整套测试，不能每跳都跑


def close_if_done(repo, conf, d, current):
    """这件活干完没有：主控空闲下来、且 main 上出现了收尾记号时，核对一次三条门，过了就记 done
    （自动模式下 done 会顺手发下一件；放行模式下停下来等人 drover go）。
    判定交给 `drover done` —— 它本来就是这套判据的唯一实现，这里只决定「什么时候问」：

      - 只在主控 idle 时问。它还在干活时这件活当然没完，而第 3 条可能是整套测试，白跑。
      - idle 还要够久、且这一轮不是主控自己开的（契约：idle 不代表它不会再动），同 wants_human。
      - state 是 unknown 就不问：状态无从得知时不猜，让人去看。
      - 两次之间至少隔 CHECK_EVERY，记在交接目录里的一个空文件上（看它的修改时间）。

    done 退出码 9 = 判据没满足，是常态不是故障：记下时间，下一轮再问。看板那边同时会把
    「主控空闲着但判据没满足」挂进「等你」，两边说的是同一件事。"""
    a = agents_of(repo, conf.get("MAIN_AGENT", "")).get("writer")
    if not a or a["status"] != "idle" or a.get("src") == "agent" or (a.get("idle_for") or 0) < IDLE_SETTLE:
        return
    # 依据先于门：没看到收尾记号就不自动记 done。项目没配 DONE_MARK（ok=None）也一样——
    # 那时判不出完成，退回等人 drover go，绝不让最弱的默认配置把「main 前进了」当成做完了。
    if find_done_mark(repo, current.get("main", ""), conf.get("DONE_MARK", "收尾").strip())["ok"] is not True:
        return
    stamp = f"{d}/.criteria-checked"
    if NOW - (mtime(stamp) or 0) < CHECK_EVERY:
        return
    open(stamp, "w").close()
    r = subprocess.run([task_bin_path(), "done", current["id"]], cwd=repo,
                       capture_output=True, text=True, timeout=CHECK_TIMEOUT + 60)
    with open(f"{d}/.loop.log", "a", encoding="utf-8") as f:
        head = (r.stdout or r.stderr or "").strip().splitlines()[:1]
        f.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} done {current['id']} exit {r.returncode} {head[0] if head else ''}\n")


def loop_tick(list_path):
    """外层循环的一跳。循环开着的项目，看它处在哪一头：

      有进行中的任务 → 主控空闲下来时核对三条判据，过了就记 done（见 close_if_done）。
      没有进行中的   → 上一次停在队列那一步留了 .loop-wait，条件重新满足（有待办、没暂停、
                       不等放行）就跑一次 `drover next`，由它把任务正文送进主控。

    `.loop-wait` 只管后一头——它的意思就是「停在队列那一步」。有任务在做时本来就没有这个标记，
    所以核对判据那一头不能被它挡住（踩过一次）。

    和老 herdsman 的区别：老的往写手的 pane 里注入固定那句「运行 review-task next」，让写手去跑外层
    循环的命令——那是内依赖外。现在 drover 自己跑 next，送出去的是任务正文本身，和人手动粘一段
    任务进去一模一样。pane 身份核对那一整套也没了：目标是 MAIN_AGENT 这个名字。

    **每跳先把 NOW 和 corral 的 agent 清单重取一遍**，和 collect() 开头做的事一样。以前这个函数是
    `drover board serve` 里的一个线程，靠页面渲染顺带刷新；拆成独立进程之后没有渲染这回事了，
    停在启动那刻的 NOW 会让 close_if_done 的节流 `NOW - mtime(stamp) < CHECK_EVERY` 一路算出负数
    ——永远在节流窗口里，查一次之后再也不查。agent 清单同理：主控重开换了 instance 就认不出来。"""
    global NOW, _AGENTS
    NOW, _AGENTS = time.time(), None
    for repo in discover(list_path):
        conf = parse_conf(f"{repo}/.drover.conf")
        d = conf.get("HANDOFF_DIR")
        if not d or not os.path.exists(f"{d}/loop"):
            continue
        tasks, current, awaiting = task_fold(task_events(read(f"{d}/tasks.state")))
        if current:
            close_if_done(repo, conf, d, current)
            continue
        mf = f"{d}/.loop-wait"
        try:
            m = json.loads(read(mf) or "null")
        except ValueError:
            m = None
        if not isinstance(m, dict) or m.get("failed"):
            continue
        if awaiting or os.path.exists(f"{d}/paused") or not task_pending(task_blocks(read(f"{d}/queue.md")), tasks):
            continue
        before = read(mf)                    # 跑 next 期间可能又停下、写了新标记：删之前核对还是这一份
        r = subprocess.run([task_bin_path(), "next"], cwd=repo, capture_output=True, text=True, timeout=120)
        ok = r.returncode == 0
        with open(f"{d}/.loop.log", "a", encoding="utf-8") as f:
            head = (r.stdout or r.stderr or "").strip().splitlines()[:1]
            f.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} next exit {r.returncode} {head[0] if head else ''}\n")
        if ok:
            if read(mf) == before and os.path.exists(mf):
                os.remove(mf)                # next 自己也会删它；这里兜一次，免得标记留着反复触发
        else:
            m["attempts"] = m.get("attempts", 0) + 1
            m["error"] = (r.stdout or r.stderr or "next 没送出去").strip()[:200]
            if m["attempts"] >= 3:
                m["failed"] = True
            tmp = f"{mf}.{os.getpid()}.tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(m, f, ensure_ascii=False)
            os.replace(tmp, mf)


# ============================================================ 入口
def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip())
        return
    list_path, rest = None, list(args)
    while rest:
        a = rest.pop(0)
        if a == "--projects" and rest:
            list_path = rest.pop(0)
        else:
            print(f"不认识的参数：{a}\n\n{__doc__.strip()}")
            sys.exit(2)
    if not sys.stdout.isatty():
        print("drover board 是个 TUI，要在终端里跑。")
        sys.exit(2)
    curses.wrapper(tui, list_path)


if __name__ == "__main__":
    main()
