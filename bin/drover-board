#!/usr/bin/env python3
"""drover board — a terminal Kanban for task queues.

Usage:
  drover board                 Open the board
  drover board --projects F    Use a project list at F (one repository per line)

Keys:
  ↑ ↓ / j k  Select project    d Submit · g Accept        n Dispatch pending
  p  Pause / resume            a  Edit queue.md
  r  Refresh                   q  Quit                   PgUp/PgDn  Scroll details

The board reads registered repositories from ~/.drover/projects. Task text and
external command output are shown as written; board labels and feedback are in English.
"""
import curses
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import unicodedata
from datetime import datetime
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import drover_core as C
from drover_core import parse_conf, task_blocks, task_events, task_fold, task_pending, TASK_HDR

PROJ_LIST = os.path.expanduser("~/.drover/projects")
NOW = time.time()


# ============================================================ 读文件 / git
def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return None


def git(repo, *args):
    try:
        return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, timeout=30).stdout
    except Exception:
        return ""


_AGENTS = None

# corral 只用三个命令：send / status / ls。契约见 ~/Developer/personal_projs/corral/docs/CONTRACT.md。
# 不用 corral read：契约里写死了「没有终端模拟，agent 重绘时文字会乱，只作排查用，不要解析」。
# 「正在调什么工具 / 这一轮多久」改用 status 的 last_tool + turn_started，那是结构化字段。
CORRAL = os.environ.get("DROVER_CORRAL_BIN", "corral")
# 契约「退出码」一节：0 ok，2 不存在，3 送了没确认，4 超时，7 不是 idle，8 最近 30 秒有人在打字。
CORRAL_NOT_FOUND, CORRAL_NOT_DELIVERED, CORRAL_NOT_IDLE, CORRAL_HUMAN_ACTIVE = 2, 3, 7, 8


def corral(*args, timeout=10):
    """跑一条 corral 命令 → (退出码, JSON dict)。契约：每条命令在标准输出写一行 JSON。
    corral 不在、超时、输出不是 JSON，都当作「查不到」返回 (None, {})，不能把看板弄崩。"""
    try:
        r = subprocess.run([CORRAL, *args], capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None, {}
    try:
        return r.returncode, json.loads(r.stdout.strip().splitlines()[-1])
    except Exception:
        return r.returncode, {}


def corral_agents():
    """`corral ls` 一次，全页共用；corral 不在就是空列表。"""
    global _AGENTS
    if _AGENTS is None:
        _, j = corral("ls")
        _AGENTS = j.get("agents") or []
    return _AGENTS


def corral_status(name):
    """`corral status <名字>`；查不到返回 None。"""
    if not name:
        return None
    code, j = corral("status", name)
    return j if code == 0 and j.get("ok") else None


CREW_TIMEOUT = 2     # 问一个干活 agent 的状态最多等这么久。它只是显示，不能把整块看板拖住


def crew_of(repo, main_agent=""):
    """这个仓库的 worktree 里住着哪些 agent → [{name, kind, state, since}]，按名字排。

    **只显示状态，不做 agent 看板。** `m5` 删掉过一个重量级的（在调什么工具、卡住没有、接入
    命令），理由是 corral 的 board 已经做了而且更准。2026-09-22 用户要求加回轻量版：派出去的
    agent 是死是活，在 drover 这边一眼看得见。边界照旧——**不加"在调什么工具""接入去看"这类**，
    那些仍旧是 corral board 的活；drover 是任务看板。

    归属靠 `git worktree list` 的路径反推（契约只给 cwd），主控自己不算在内。查不到状态的
    照样列出来、标 unknown：**列表本身就是信息**（有几个 agent 住在这个仓库里）。"""
    real = lambda x: os.path.realpath(x) if x else ""
    roots = {real(ln.split()[0]) for ln in git(repo, "worktree", "list").splitlines() if ln.strip()}
    roots.add(real(repo))
    if not roots:
        return []
    crew = []
    for a in corral_agents():
        cwd, name = real(a.get("cwd")), a.get("name") or ""
        if not cwd or not name or name == main_agent:
            continue
        if not any(cwd == r or cwd.startswith(r + os.sep) for r in roots):
            continue
        code, j = corral("status", name, timeout=CREW_TIMEOUT)
        ok = code == 0 and j.get("ok")
        crew.append({"name": name, "kind": a.get("kind") or "",
                     "state": (j.get("state") or "unknown") if ok else "unknown",
                     "since": (j.get("idle_for") or 0) if ok else 0,
                     "where": os.path.basename(cwd)})
    return sorted(crew, key=lambda c: c["name"])


def agents_of(repo, main_agent=""):
    """{"writer": info}：主控。配了 MAIN_AGENT 就按名字问 corral status（权威）；
    没配就退回「cwd 是这个仓库的 agent」——项目还没接上 corral 时看板照样能显示点东西。"""
    st = corral_status(main_agent)
    if st is None and not main_agent:
        real = lambda x: os.path.realpath(x) if x else ""
        hit = next((a for a in corral_agents() if real(a.get("cwd")) == real(repo)), None)
        st = corral_status(hit.get("name")) if hit else None
    if st is None:
        return {}
    return {"writer": {"status": st.get("state") or "unknown", "name": st.get("name", ""),
                       "idle_for": st.get("idle_for") or 0, "src": st.get("last_input_source", "")}}


def dur(sec):
    """一段时长 → 给人看的短写法。看板上所有时长都走这里，**只有这一套口径**：
    不满一分钟写秒（任务的耗时可能真就几十秒，写成 0m 等于没说）。"""
    d = max(0, int(sec))
    if d < 60:
        return f"{d}s"
    if d < 3600:
        return f"{d // 60}m"
    if d < 86400:
        return f"{d // 3600}h{(d % 3600) // 60:02d}m"
    return f"{d // 86400}d"


def ago(ts):
    return dur(NOW - ts) if ts else ""


# ============================================================ 解析交接文件


# ============================================================ 项目状态


def attach_hint(name):
    """「等你」的每一条都带上怎么去看——人看到横幅，下一步就是接入那个 agent。
    drover 自己**不跑** attach（只用 send / status / ls），这只是一句给人抄的话。"""
    return f"去看看：corral attach {name}" if name else "去主控那边看看"


def add_waits(p):
    tv = p.get('tasks')
    if tv and tv['awaiting'] and tv['card']:
        p['human'].append(('release', '', '', '', f"{tv['awaiting']} 已提交，等待用户验收。接受不会派发下一项。"))
        p.update(state='等你放行', needs_me=True, waiting='等你')


# ============================================================ 任务队列（drover 与看板共用这份解析）


# 正文里那行「任务文件：<相对路径>」：人自己在 queue.md 里写的。
TASK_FILE = re.compile(r'^\s*任务文件\s*[:：]\s*(\S.*?)\s*$', re.M)
# 任务文件开头那行「路由：<档> / 交叉审查<要|不要>（路由：…；推翻：…）」。这是主控**本来就会写**
# 的一行（corral-dispatch 的 SKILL.md 第 3 节规定的记录格式），drover 只读、只显示。
TASK_ROUTE = re.compile(r'^\s*路由\s*[:：]\s*([^/（(]+?)\s*/\s*交叉审查\s*(不要|要)(?:\s*[（(](.*)[）)])?')
TASK_OVERRIDE = re.compile(r'推翻\s*[:：]\s*(.*)')
# 「推翻：无」后面主控常接着写别的话（把没推翻的理由也记在这一段里），只看开头那两个字
TASK_NO_OVERRIDE = re.compile(r'^(?:无|没有)(?:[。；;.、,，]|$)')
ROUTE_HEAD = 20         # 只看任务文件开头这些行：正文里举例子、引用格式的地方不算数


def task_files(repo, body, title, task_dir):
    """这件活的任务文件候选，按优先顺序 → [绝对路径]。两条路：

      1. 队列条目正文里写了「任务文件：<相对路径>」就**只认它**（和「验收：」同一套机制），
         不再往下走前缀匹配——它没有那一行就是没有；
      2. 没写，就是 TASK_FILE_DIR 里文件名以队列条目标题开头的那些 .md，按文件名排序。

    第 2 条给的是一串而不是一个：同一个前缀底下常常不止一份（交叉审查、审查意见都跟着任务
    同名开头，真实的 docs/任务/ 里就有），排序第一的那份未必是任务文件本身。挑哪一份由
    task_route 定——它挑第一份真带「路由：」行的。"""
    m = TASK_FILE.search(body or "")
    if m:
        p = os.path.join(repo, os.path.expanduser(m.group(1)))
        return [p] if os.path.isfile(p) else []
    if not task_dir or not title:
        return []
    d = os.path.join(repo, os.path.expanduser(task_dir))
    try:
        return [os.path.join(d, n) for n in sorted(os.listdir(d))
                if n.endswith(".md") and n.startswith(title)]
    except OSError:
        return []


def route_line(path):
    """一份任务文件开头那行「路由：…」→ {"tier": 档位, "cross": 要不要交叉审查,
    "overridden": 主控推翻没有}；没有那一行、读不了、编码坏了都是 None。"""
    try:
        with open(path, encoding="utf-8") as f:
            head = [next(f, "") for _ in range(ROUTE_HEAD)]
    except Exception:
        return None
    for line in head:
        m = TASK_ROUTE.match(line)
        if not m:
            continue
        # 「推翻：无」和不写这一段都是没推翻；写了别的才算主控推翻了路由的结论
        why = TASK_OVERRIDE.search(m.group(3) or "")
        t = why.group(1).strip() if why else ""
        return {"tier": m.group(1), "cross": m.group(2) == "要",
                "overridden": bool(t) and not TASK_NO_OVERRIDE.match(t)}
    return None


def task_route(repo, body, title, task_dir):
    """这件活的路由：候选文件里第一份带「路由：」行的那一份怎么写的 → {tier, cross, overridden}，
    一份都挑不出来就 None（页面上这一项不显示）。

    **只进显示，绝不参与任何判断**（ROADMAP 待定 4）：不进完成判据、不进 wants_human、不进
    任务流转。它依赖内循环的一个书写格式，算擦边，但不要求主控多做事；漏读只是
    少显示一项，不影响判完成——所以不需要收尾记号那条例外的三条支撑。

    降级是硬要求：没配 TASK_FILE_DIR、目录不在、文件找不到、没有那一行、格式对不上、编码坏了
    ——一律返回 None，一个异常都不许漏出去，看板不能因为一行文案崩掉。"""
    try:
        return next((r for r in (route_line(p) for p in task_files(repo, body, title, task_dir)) if r), None)
    except Exception:
        return None


def queue_version(text):
    """queue.md 内容的短指纹：页面记下它，改顺序 / 改任务时带回来，对不上说明这期间队列被别人改过。"""
    return hashlib.sha1((text or "").encode("utf-8")).hexdigest()[:12]




# ============================================================ 仓库参考（不参与流转）
MAIN_BRANCH = "main"


def task_span(a, b):
    """两个时刻之间有多久。缺一头就不显示——写成 0 会被当成「真的是 0」。"""
    return dur(b - a) if a and b else ""


def task_commit_count(repo, a, b):
    if not a or not b:
        return None
    value = C.git_value(repo, 'rev-list', '--count', f'{a}..{b}', '--')
    return int(value) if value is not None and value.isdigit() else None


def history_commit_counts(repo, history):
    """当次历史记账：传播起止可达标记，统计 b 可达而 a 不可达的提交。"""
    ranges = [(f["id"], f.get("start"), f.get("end")) for f in history if f["status"] != "dropped"]
    counts = {tid: 0 if a and b else None for tid, a, b in ranges}
    active = [(tid, a, b) for tid, a, b in ranges if a and b and a != b]
    if not active:
        return counts
    endpoints = {sha for _, a, b in active for sha in (a, b)}
    # 事件通常记录完整 SHA；符号引用、标签对象或坏端点继续使用原查询契约。
    rows = []
    if all(re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", sha) for sha in endpoints):
        try:
            result = subprocess.run(["git", "-C", repo, "rev-list", "--parents", "--topo-order",
                                     *sorted(endpoints), "--"], capture_output=True, text=True, timeout=30)
            if result.returncode == 0:
                rows = [line.split() for line in result.stdout.splitlines() if line]
        except (OSError, subprocess.SubprocessError):
            pass                                    # 批量失败（含部分输出）退回原逐条结果
    if not endpoints <= {row[0] for row in rows}:
        return {tid: task_commit_count(repo, a, b) for tid, a, b in ranges}
    marks = {}
    for i, (_, a, b) in enumerate(active):
        marks.setdefault(a, [0, 0])[0] |= 1 << i
        marks.setdefault(b, [0, 0])[1] |= 1 << i
    # --topo-order 保证先子后父；每个区间一个位，不保存每个端点的祖先集合。
    for sha, *parents in rows:
        starts, ends = marks.pop(sha, (0, 0))
        included = ends & ~starts
        while included:
            bit = included & -included
            counts[active[bit.bit_length() - 1][0]] += 1
            included ^= bit
        for parent in parents:
            mark = marks.setdefault(parent, [0, 0])
            mark[0] |= starts
            mark[1] |= ends
    return counts


def task_view(repo, conf, p):
    """任务区要显示的东西。项目没有 queue.md（没用队列）就返回 None，页面上不出现任务区。"""
    d = conf["HANDOFF_DIR"]
    qtext = read(f"{d}/queue.md")
    if qtext is None:
        return None
    task_dir = conf.get("TASK_FILE_DIR", "")       # 找任务文件读「路由：」行用的，纯显示
    snap = C.snapshot(repo)
    public = C.listing(snap)
    tasks, current, awaiting = snap['tasks'], snap['current'], snap['awaiting']
    t = current or tasks.get(awaiting)
    card = None
    if t:
        n = task_commit_count(repo, t["start"], t.get("end") or p["head"])
        now = "收尾" if t["id"] == awaiting else "实施"
        confirmation = "已提交"
        steps = [
            ("实施", "now" if now == "实施" else "ok", f"{n} 个提交" if n else "—"),
            ("收尾", "now release" if now == "收尾" else "", f"{confirmation} · 等你放行" if now == "收尾" else "按 d 提交验收"),
        ]
        # 分支进展：从发任务那一刻的 main 算起，main 上多了几个提交、最后一次多久前。
        # 仅为仓库区间参考，不代表本任务的工作归属。
        base = t.get("main", "")
        on_main = task_commit_count(repo, base, MAIN_BRANCH)
        last_at = int(git(repo, "log", "-1", "--format=%ct", MAIN_BRANCH).strip() or 0) if on_main else 0
        card = {"id": t["id"], "title": t["title"], "start": t["start"], "main": base,
                "completion_record": t.get("completion_record"),
                "on_main": on_main, "last_at": last_at,
                "commits": n, "steps": steps, "body": t.get("body", ""),
                "actions": C.task_actions(snap, t),
                "waiting": now == "收尾", "span": task_span(t.get("t0"), t.get("t1") or NOW),
                # 任务文件开头那行「路由：…」，只显示，不参与任何判断；读不出来就是 None
                "route": task_route(repo, t.get("body", ""), t.get("title", ""), task_dir)}
    finished = []
    history = [x for x in tasks.values() if x["status"] in ("done", "dropped") and x["id"] != awaiting]
    commit_counts = history_commit_counts(repo, history)
    for f in reversed(history):
        if f["status"] == "dropped":
            finished.append({"id": f["id"], "title": f["title"], "dropped": True, "reason": f.get("reason", ""), "body": f.get("body", "")})
            continue
        # 记账三项（ROADMAP 待定 3）：耗时、提交数、等放行时长。全部从现有事件流和 git 算，
        # 不加新事件。**「返工轮数」不做**——drover 看不见主控和 dev agent 之间的往返（硬规矩
        # 第 4 条），记不出来；提交数就叫提交数，不冒充它。
        finished.append({"id": f["id"], "title": f["title"], "dropped": False, "span": task_span(f.get("t0"), f.get("t1")),
                         "commits": commit_counts[f["id"]],
                         "wait": task_span(f.get("t1"), f.get("t2")),   # 自动模式没有 go 事件：这一项没有，不是 0
                         # 路由也记进来（待定 3 列的记账内容里就有「路由判了什么 / 推翻没有」）
                         "route": task_route(repo, f.get("body", ""), f.get("title", ""), task_dir),
                         "body": f.get("body", ""),
                         "range": f"{f['start'][:7]}..{f['end'][:7]}" if f.get("end") and f["end"] != f["start"] else ""})
    return {"dir": d, "todo": public['pending'], "card": card, "finished": finished, "qv": queue_version(qtext),
            "awaiting": awaiting, "paused": snap['paused'],
            "done": sum(x['status'] == 'done' for x in tasks.values()),
            "dropped": sum(x['status'] == 'dropped' for x in tasks.values())}


def project_state(repo, conf):
    d = conf["HANDOFF_DIR"]
    p = {"name": os.path.basename(repo), "repo": repo, "dir": d,
         "head": git(repo, "rev-parse", "HEAD").strip(),
         "state": "空闲", "since": None, "waiting": "", "needs_me": False, "human": []}
    p["last_activity"] = max([mtime(f"{d}/{f}") or 0 for f in os.listdir(d)] or [0]) if os.path.isdir(d) else 0
    p["main_agent"] = conf.get("MAIN_AGENT", "")
    p["agents"] = agents_of(repo, p["main_agent"])
    p["crew"] = crew_of(repo, p["main_agent"])   # 住在本仓库 worktree 里的 agent，只显示
    p["tasks"] = task_view(repo, conf, p)
    add_waits(p)
    return p


# ============================================================ 项目发现
def discover(list_path):
    """只认登记过的仓库：~/.drover/projects 一行一个（drover-init 会写进去）。
    不扫目录——「哪个目录下多了个 .drover.conf 就自动接进来」听着方便，实际是让看板去够它没被告知的东西。"""
    repos = []
    for line in (read(list_path or PROJ_LIST) or "").splitlines():
        line = os.path.expanduser(line.strip())
        if line and not line.startswith("#") and os.path.isfile(f"{line}/.drover.conf"):
            repos.append(line)
    seen, out = set(), []
    for r in sorted(set(repos)):
        real = os.path.realpath(r)
        if real not in seen:
            seen.add(real); out.append(r)
    return out


def collect(list_path):
    """各项目的当前状态。看板每刷新一次就整个重跑一遍——不存状态，刷新等于重跑。
    NOW 每次重取：看板是常驻前台进程，停在启动那刻的 NOW 会让「几分钟前」「已进行多久」越来越偏。"""
    global NOW, _AGENTS
    NOW, _AGENTS = time.time(), None                 # corral 的 agent 列表同理：每页重查
    projects = []
    for repo in discover(list_path):
        conf = parse_conf(f"{repo}/.drover.conf")
        if "HANDOFF_DIR" not in conf:
            continue
        try:
            projects.append(project_state(repo, conf))
        except C.FlowError as exc:
            projects.append({'name': os.path.basename(repo), 'repo': repo, 'dir': conf['HANDOFF_DIR'],
                             'head': '', 'state': 'Unavailable', 'since': None, 'waiting': '',
                             'needs_me': True, 'human': [('error', '', '', '', exc.why)],
                             'last_activity': 0, 'tasks': None})
    # 同名仓库（不同目录下的同名 checkout）用上一级目录区分，name 是页面里的唯一键
    names = [p["name"] for p in projects]
    for p in projects:
        if names.count(p["name"]) > 1:
            p["name"] = os.path.basename(os.path.dirname(p["repo"])) + "/" + p["name"]
    projects.sort(key=lambda p: (not p["needs_me"], -(p["since"] or p["last_activity"] or 0), p["name"]))
    return projects


# ============================================================ 显示宽度
def cell(c):
    """一个字符在终端里占几格：东亚宽字符（W / F）两格，组合字符（声调符号之类）不占格。"""
    return 0 if unicodedata.combining(c) else (2 if unicodedata.east_asian_width(c) in ("W", "F") else 1)


def width(s):
    """字符串占几格。curses 按字符数排版会错位：「把 CSS 导入改成流式」是 12 个字符、19 格。
    所有排版都得过这里，一开始就算对，不然满屏是歪的。"""
    return sum(cell(c) for c in s)


def trunc(s, n):
    """截到显示宽度不超过 n 格；截过就以 … 结尾（… 占 1 格）。"""
    if n <= 0:
        return ""
    if width(s) <= n:
        return s
    out, w = [], 0
    for c in s:
        if w + cell(c) > n - 1:
            break
        out.append(c)
        w += cell(c)
    return "".join(out) + "…"


# ============================================================ view_model：要显示什么
def health():
    """顶栏那句健康提示。数据源只剩 corral —— launchd 托管、静态页多久没刷、服务跑的是不是
    旧代码，那几项跟着网页层一起删了：看板现在是你自己开的前台进程，这些一眼就看得见。"""
    code, _ = corral("ls", timeout=3)
    return {"ok": code == 0,
            "text": "corral connected" if code == 0 else "corral unavailable: agent status and task delivery are unavailable"}


def wait_items(p, english=False):
    return [(f"{p['name']}|{kind}|{reason}",
             f"{p['tasks']['awaiting']} submitted; press g to accept. Dispatch is separate."
             if english and kind == 'release' else reason)
            for kind, fid, verb, sev, reason in p['human']]


def card_vm(p, tv):
    c = tv['card']
    if not c:
        return None
    snap = C.snapshot(p['repo'])
    facts = C.evidence(snap, snap['tasks'][c['id']])
    g, check = facts['git'], facts['last_check']
    why = check['state']
    if check['record']:
        why += ': ' + check['record']['why']
    return {**c, 'body': text_lines(c.get('body', '')),
            'progress': 'Repository reference only; no task attribution or acceptance verdict',
            'evidence': [
                {'name': 'Git', 'ok': None, 'why': g['state']},
                {'name': 'Tracked changes', 'ok': None, 'why': str(len(g['tracked_changes'])) if g['state'] == 'available' else 'unknown'},
                {'name': 'Unmerged local branches', 'ok': None, 'why': ', '.join(g['unmerged_local_branches']) or ('none' if g['state'] == 'available' else 'unknown')},
                {'name': 'Previous check', 'ok': None, 'failed': bool(check['record'] and check['record']['ok'] is False), 'why': why}]}


def text_lines(text):
    """正文 → 去掉行尾空白和末尾空行的行列表，只进显示。"""
    lines = [ln.rstrip() for ln in (text or "").splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    return lines


def pending_task_file(repo, body):
    """待办正文里显式写的「任务文件：<路径>」→ {path, text 行列表；找不到为 None}；没写就是 None。
    只认这一行，不按标题前缀找——待办还没派出去时任务单多半还不存在。只读，不写。"""
    m = TASK_FILE.search(body or "")
    if not m:
        return None
    try:
        with open(os.path.join(repo, os.path.expanduser(m.group(1))), encoding="utf-8", errors="replace") as f:
            text = text_lines(f.read())
    except OSError:
        text = None
    return {"path": m.group(1), "text": text}


def queue_vm(p, tv):
    c = tv["card"]
    return {"mode": "Paused" if tv["paused"] else "Explicit",
            "paused": tv["paused"], "awaiting": tv["awaiting"],
            "counts": {"todo": len(tv["todo"]), "doing": 1 if c and not c["waiting"] else 0,
                       "done": tv["done"], "dropped": tv["dropped"]},
            "card": card_vm(p, tv),
            "crew": p.get("crew") or [],
            "todo": [{"id": b["id"] or "", "title": b["title"], "next": i == 0,
                      "actions": b["actions"], "body": text_lines(b["body"]),
                      "task_file": pending_task_file(p["repo"], b["body"])} for i, b in enumerate(tv["todo"])],
            "finished": [{"id": f["id"], "title": f["title"], "dropped": f["dropped"],
                          "reason": f.get("reason", ""), "span": f.get("span", ""), "range": f.get("range", ""),
                          "commits": f.get("commits", 0), "wait": f.get("wait", ""), "route": f.get("route")}
                         for f in tv["finished"]]}


def project_vm(p):
    tv = p.get("tasks")
    return {"name": p["name"], "repo": p["repo"], "dir": p["dir"], "head": p["head"][:7],
            "state": {"空闲": "Idle", "等你放行": "Ready to release"}.get(p["state"], p["state"]),
            "waiting": p["waiting"], "needs_me": p["needs_me"],
            # 按「谁在等」分档：me = 等你，wr = 等主控，none = 没人在等
            "badge": "me" if p["needs_me"] else ("wr" if p["waiting"] else "none"),
            "age": ago(p["since"]),
            "waits": [text for _, text in wait_items(p, english=True)],
            "queue": queue_vm(p, tv) if tv else None}


def view_model(projects):
    """看板要显示的一切，一份纯数据 —— 不碰 curses，也不管怎么画。

    分 view_model / draw 两层是为了能验：断言全打在这份字典上，比 grep 画面结实（换个排版、
    换个配色不会挂）。画那一层薄到只补一条「画进很窄的假屏幕不崩、不越界」的冒烟就够。"""
    project_views = [project_vm(p) for p in projects]
    return {"health": health(),
            "waits": [{"project": p["name"], "text": text, "age": ago(p["since"])}
                      for p, view in zip(projects, project_views) for text in view["waits"]],
            "projects": project_views}


# ============================================================ draw：怎么画
RAIL = 20            # 左边项目列表的宽度上限
COLORS = {}          # 样式名 → curses 属性。TUI 启动时填；没填（测试里画进假屏幕）就一律 0


def init_colors():
    """深色：只设前景色，背景交给终端自己（use_default_colors）。看板一直是深色的，不为浅色折中。"""
    COLORS.update(h1=curses.A_BOLD, h2=curses.A_BOLD,
                  heading_wait=curses.A_BOLD, heading_active=curses.A_BOLD, heading_idle=curses.A_BOLD,
                  sel=curses.A_BOLD | curses.A_REVERSE,
                  key=curses.A_BOLD, inactive=curses.A_BOLD, bar=0, history=0, history_heading=0,
                  account=curses.A_DIM, line=curses.A_DIM)
    try:
        curses.start_color()
        curses.use_default_colors()
    except curses.error:
        return
    extended = getattr(curses, "COLORS", 0) >= 256
    for i, (kind, fg) in enumerate([("wait", curses.COLOR_YELLOW), ("bad", curses.COLOR_RED),
                                    ("ok", curses.COLOR_GREEN), ("sel", curses.COLOR_YELLOW),
                                    ("dim", 248 if extended else -1), ("line", 240 if extended else -1),
                                    ("accent", 180 if extended else -1),  # 沙色 #D7AF87
                                    ("account", 245 if extended else -1),
                                    ("active", 81 if extended else curses.COLOR_CYAN)], start=1):
        try:
            curses.init_pair(i, fg, -1)
        except curses.error:
            continue
        COLORS[kind] = curses.color_pair(i)
    if extended:  # 项目栏选中行：深灰底（同 corral board 选中行），▸ 沙色、! 黄；少色终端沿用整块反色
        for i, (kind, fg) in enumerate([("rail_sel", -1), ("rail_mark", 180), ("rail_need", curses.COLOR_YELLOW)], start=20):
            try:
                curses.init_pair(i, fg, 237)
            except curses.error:
                break
            COLORS[kind] = curses.color_pair(i) | curses.A_BOLD
        for i, (kind, fg) in enumerate([("chip", -1), ("chip_dim", 245)], start=23):  # 窄面板 header 的当前项目
            try:
                curses.init_pair(i, fg, 237)
            except curses.error:
                break
            COLORS[kind] = curses.color_pair(i)
    COLORS["h2"] = COLORS["key"] = COLORS.get("accent", 0) | curses.A_BOLD
    COLORS["history_heading"] = COLORS.get("accent", 0)
    COLORS["bar"] = COLORS.get("dim", 0)
    COLORS["heading_wait"] = COLORS.get("wait", 0) | curses.A_BOLD
    COLORS["heading_active"] = COLORS.get("active", 0) | curses.A_BOLD
    COLORS["heading_idle"] = COLORS.get("accent", 0) | curses.A_BOLD
    COLORS["inactive"] = COLORS.get("dim", 0) | curses.A_BOLD
    COLORS["sel"] = COLORS.get("sel", 0) | curses.A_BOLD
    COLORS["sel"] = COLORS.get("sel", 0) | curses.A_REVERSE
    if not extended:
        COLORS["account"] = COLORS.get("account", 0) | curses.A_DIM
        COLORS["line"] = COLORS.get("line", 0) | curses.A_DIM


def put(stdscr, y, x, text, h, w, kind=""):
    """写一行，截到屏幕里。kind 可为 (底色, (起, 止, 色), ...)，范围按字符、顺序不重叠。
    右下角那一格 curses 写不得，最后一行少用一格。"""
    if y < 0 or y >= h or x < 0 or x >= w:
        return
    t = trunc(text, w - x - (1 if y == h - 1 else 0))
    if t and isinstance(kind, tuple):
        base, *spans = kind
        at = 0
        for start, end, color in spans:
            for part, style in ((t[at:start], base), (t[start:end], color)):
                put(stdscr, y, x, part, h, w, style)
                x += width(part)
            at = end
        put(stdscr, y, x, t[at:], h, w, base)
    elif t:
        stdscr.addstr(y, x, t, COLORS.get(kind, 0))


def put_heading(stdscr, y, x, text, h, w, status, kind):
    """标题保留原文字与位置，只给状态词着色。"""
    if kind and text.startswith(status):
        put(stdscr, y, x, status, h, w, kind)
        put(stdscr, y, x + width(status), text[len(status):], h, w, "h1")
    else:
        put(stdscr, y, x, text, h, w, "h1")


def put_scrollbar(stdscr, x, y, height, total, visible, offset, h, w):
    """一列位置条；不足一页隐藏，首尾贴边，只画当前可见区域。"""
    if height <= 0 or visible <= 0 or total <= visible:
        return
    thumb = max(1, min(height - 1, height * visible // total))
    start = (height - thumb) * min(max(0, offset), total - visible) // (total - visible)
    for row in range(height):
        on = start <= row < start + thumb
        put(stdscr, y + row, x, "┃" if on else "│", h, w, "dim" if on else "line")


def status_color(state):
    """同一状态在摘要与 agent 行使用同一种颜色；未知值不猜。"""
    return {"Idle": "accent", "idle": "accent", "空闲": "accent",
            "In progress": "active", "working": "active", "starting": "active",
            "Ready to release": "wait", "等你放行": "wait", "blocked": "wait"}.get(state, "dim")


def route_tier(rt):
    """Only known tier labels are UI text; keep unfamiliar task-file values verbatim."""
    return {"轻": "Light", "轻档": "Light", "常规": "Standard", "常规档": "Standard",
            "重": "Heavy", "重档": "Heavy"}.get(rt["tier"], rt["tier"])


def route_chip(rt):
    """路由缩成一个词：「重档」「常规档（推翻）」。没有路由就是空字符串，整项不出现。
    历史指标另起一行，路由用短标签；全的在「当前这件活」里。"""
    return (route_tier(rt) + (" (overridden)" if rt["overridden"] else "")) if rt else ""


def task_heading(pv):
    """固定标题只用已有任务状态，不从核对消息推导新的运行状态。"""
    q = pv["queue"]
    c = q["card"] if q else None
    if not q:
        return "○ Idle  No task queue · press a to create one"
    if c:
        return ("■ Ready to release" if c["waiting"] else "▶ In progress") + f'  {c["id"]} {c["title"]}'
    return "○ Idle  " + ("No active task · press n for the next one" if q["todo"] else
                         "Queue empty · press a to add a task")


def commit_count(n):
    if n is None:
        return 'commits unknown'
    return f'{n} commit{"" if n == 1 else "s"}'


def task_metrics(pv):
    q = pv["queue"]
    c = q["card"] if q else None
    if not c:
        state = {"空闲": "Idle", "等你放行": "Ready to release"}.get(pv["state"], pv["state"])
        return f'{pv["name"]} · {state} · HEAD {pv["head"]}'
    rt = c["route"]
    main_count = c["on_main"] if c["on_main"] is not None else "?"
    return (f'Elapsed {c["span"]} · {commit_count(c["commits"])} · main +{main_count}'
            + (f' · {route_tier(rt)} · Cross-review {"yes" if rt["cross"] else "no"}' if rt else "")
            )


def history_lines(f, presentation=False):
    """一条历史的完整标题及记账/原因；默认共享文本格式保持不变。"""
    acct = " · ".join(x for x in (route_chip(f["route"]), f["span"], commit_count(f["commits"]),
                                  f'Release wait {f["wait"]}' if f["wait"] else "") if x)
    return [(("history", (0, 1, "dim" if f["dropped"] else "ok")) if presentation else "bad" if f["dropped"] else "", 2,
             f'{"✕" if f["dropped"] else "✓"} {f["id"]} {f["title"]}'),
            ("account" if presentation and not f["dropped"] else "dim", 4,
             f'Dropped: {f["reason"]}' if f["dropped"] else acct)]


def section(kind, text, presentation):
    """节标题一行。绘制时只有名字用栏目色，「· 数字」退成记账灰；默认格式不变。"""
    at = text.find(" · ")
    return ((kind, (at, len(text), "account")) if presentation and at > 0 else kind), 0, text


def detail_sections(pv, body=None, presentation=False, history=None):
    """主辅栏逻辑行；默认保留共享详情格式，绘制时才分开判据标签和理由。"""
    main, side = [], []
    if pv["waits"]:
        main.append(("wait", 0, f'Needs you · {len(pv["waits"])}'))
        main += [("wait", 2, f"· {t}") for t in pv["waits"]]
        main.append(("", 0, ""))
    q = pv["queue"]
    if not q:
        main.append(("", 0, "No task queue: queue.md is missing. Press a to create one."))
        return main, side
    c = q["card"]
    if c:
        main.append(("h2", 0, "Task details"))
        main += body if body is not None else [("", 2, ln) if ln else ("", 0, "")
                                              for ln in c.get("body") or []]
        main.append(("", 0, ""))
        main.append(section("h2", 'Repository reference', presentation))
        main.append(("dim", 2, c["progress"]))
        if c['waiting']:
            main.append(('wait', 2, 'Submitted; press g to accept'))
        if c["route"]:
            rt = c["route"]
            main.append(("dim", 2, f'Routing {route_tier(rt)} · Cross-review {"yes" if rt["cross"] else "no"}'
                                  + (" · Main agent overrode routing" if rt["overridden"] else "")))
        for r in c["evidence"]:
            mark = "✓" if r["ok"] else ("–" if r["ok"] is None else "✗")
            # 只压平 ASCII 控制空白，合法 Unicode 名称原样保留。
            why = re.sub(r"[\t\n\v\f\r\x1c-\x1f]+", " ", r["why"])
            kind = "ok" if r["ok"] else ("bad" if r.get("failed", False) else "dim")
            label = f'{mark} {r["name"]}: '
            main.append((kind, 2, label if presentation else label + why))
            if presentation:
                main.append(("", 4, why))
        main.append(("", 0, ""))
    crew = q.get("crew") or []
    if crew:
        side.append(section("h2", f'Agents · {len(crew)}', presentation))
        for a in crew:
            tail = " · ".join(x for x in (
                f'idle for {dur(a["since"])}' if a["state"] == "idle" and a["since"] else "",
                a["where"]) if x)
            color = status_color(a["state"])
            start = len(a["name"]) + 2
            side.append((("", (start, start + len(a["state"]), color)) if presentation else color, 2,
                         f'{a["name"]}  {a["state"]}' + (f'  {tail}' if tail else "")))
        side.append(("", 0, ""))
    side.append(section("h2", f'Up next · {q["counts"]["todo"]}', presentation))
    for i, t in enumerate(q["todo"]):
        prefix = f'{i + 1}. ' + ("▸ Next · " if t["next"] else "")
        text = prefix + (f'{t["id"]} ' if t["id"] else "Unnumbered ") + t["title"]
        spans = [(0, len(f'{i + 1}. '), "dim")]
        if t["next"]:
            spans.append((spans[0][1], len(prefix), "accent"))
        side.append((("", *spans) if presentation else "", 2, text))
    if not q["todo"]:
        side.append(("dim", 2, "No pending tasks"))
    side += [("", 0, ""), section("history_heading" if presentation else "h2", f'History · Done {q["counts"]["done"]}'
                                  + (f' · Dropped {q["counts"]["dropped"]}' if q["counts"]["dropped"] else ""), presentation)]
    side += history if history is not None else [line for f in q["finished"] for line in history_lines(f, presentation)]
    if not q["finished"]:
        side.append(("dim", 2, "None yet"))
    return main, side


def detail_lines(pv):
    """完整单栏内容，供详情文本检查复用。"""
    main, side = detail_sections(pv)
    return [("h1", 0, task_heading(pv)), ("dim", 0, task_metrics(pv))] + main + side


def wrap_lines(lines, cols):
    """按显示列换行；保留空格、组合字符及 Unicode 名称，不用 split/strip。"""
    out = []
    for kind, indent, text in lines:
        base = kind[0] if isinstance(kind, tuple) else kind
        if isinstance(kind, tuple):
            kind = (base, *((len(text[:a].replace("\t", "    ")),
                            len(text[:b].replace("\t", "    ")), color) for a, b, color in kind[1:]))
        indent = min(indent, max(0, cols - 2))
        room = max(2, cols - indent)
        part, used, start = "", 0, 0
        # Tab 在展示副本中固定为四个空格，避免 curses 按屏幕制表位展开后越过栏界。
        for char in text.replace("\t", "    "):
            size = cell(char)
            if used + size > room:
                out.append((slice_style(kind, start, start + len(part)), indent, part))
                start += len(part)
                part, used = "", 0
                if base == "history" and indent == 2:
                    indent = min(4, max(0, cols - 2))
                    room = max(2, cols - indent)
            part += char
            used += size
        out.append((slice_style(kind, start, start + len(part)), indent, part))
    return out


def slice_style(kind, start, end):
    """只随字符范围搬运样式；用户标题里出现同样符号也不会被当成状态。"""
    if not isinstance(kind, tuple):
        return kind
    return (kind[0], *((max(a, start) - start, min(b, end) - start, color)
                      for a, b, color in kind[1:] if a < end and b > start))


def detail_viewport(total, room, offset, pages=0):
    """纯排版计算：溢出时留一行提示，先夹住旧偏移，再翻页；没有可视行就归零。"""
    page = max(0, room - (1 if total > room else 0))
    limit = max(0, total - page) if page else 0
    offset = min(max(0, offset), limit)
    return min(max(0, offset + pages * page), limit), page


def footer_only_message(msg, card, cols):
    """只认已知普通回执；不确定、带额外说明或末行放不下时保留正文。"""
    if (not msg or any(ch != "\t" and not ch.isprintable() for ch in msg)
            or width(msg.replace("\t", "    ")) > cols
            or any(word in msg for word in ("警告", "拒绝", "WARNING", "ERROR", "↑", "未放行",
                                            "Warning", "Rejected", "Not released"))):
        return False
    if msg in ("已暂停：不再发新任务，正在做的会做完。运行 drover resume 恢复。",
               "已恢复：可以重新明确派发待办；不会自动派发。",
               "Paused: no new tasks will be sent.",
               "Resumed: explicit dispatch is enabled."):
        return True
    return bool(card and (re.fullmatch(r"已送给 [^\s：:]+[：:] ?" + re.escape(
        f'{card["id"]} {card["title"]}'), msg) or
        re.fullmatch(r"Sent to [^\s:]+: ?" + re.escape(f'{card["id"]} {card["title"]}'), msg)))


def joined(parts):
    """[(文字, 色)] → 用灰点号连成一段 (文字, 样式)；样式可直接交给 put。"""
    text, spans = "", []
    for part, color in parts:
        if text:
            spans.append((len(text), len(text) + 3, "line"))
            text += " · "
        spans.append((len(text), len(text) + len(part), color))
        text += part
    return text, ("", *spans)


def narrow_header(vm, ps, sel, cols):
    """窄面板三行 header 的展示副本 → ([三行 (文字, 样式)], 详情开头补的原文, 详情末尾补的原文)。

    第一行先按显示列宽给右侧状态留位，再分给左侧标识；右侧放不下先缩写，再从低优先级丢。
    缩写、截断或让出去的内容，原文放进详情，翻页读得到。只读 VM，默认逻辑文本不变。"""
    pv = ps[sel] if ps else None
    q = pv["queue"] if pv else None
    c = q["card"] if q else None
    health = vm["health"]
    full = []
    # 右侧 (优先级, 全称, 短标签, 色)，按列表顺序显示；优先级数越小越晚丢
    items, pending, mode = [], None, None
    if vm["waits"]:
        pending = (0, f'! Needs you {len(vm["waits"])}', f'!{len(vm["waits"])}', "wait")
        items.append(pending)
    if not health["ok"]:
        items.append((1, health["text"].split(":")[0], "corral ✗", "bad"))
    if q:
        word = "Paused" if q["paused"] else "Explicit"
        mode = [(2 if q["paused"] else 4, word, word, "wait" if q["paused"] else "accent")]
        items += mode
    name = pv["name"].replace("\t", "    ") if pv else ""
    index = f"{sel + 1}/{len(ps)}" if len(ps) > 1 else ""
    base = "drover ▸ " if pv else "drover"
    ideal = width(base + name + (" " + index if index else "")) if pv else width(base)
    # 先试全称、短标签能否和完整项目标识并排。不行就只给左侧留产品名和项目名开头：
    # 常规模式词先让出；再缩写、从低优先级丢。超窄（内容不足 32 列）时只有告警能挤掉项目名
    least = width(base) + min(width(name), 5) if pv else width(base)
    core = [i for i in items if i[0] < 4]
    alerts = [i for i in core if i[0] <= 2]
    tries = [(items, 1, ideal), (items, 2, ideal), (core, 1, least)]
    tries += [([i for i in core if i in sorted(core)[:k]], 2, least)
              for k in range(len(core), -1, -1) if cols >= 32 or k >= len(alerts)]
    tries += [([i for i in alerts if i in sorted(alerts)[:k]], 2, width("drover")) for k in range(len(alerts), -1, -1)]
    shown, at = next((kept, at) for kept, at, lim in tries
                     if width(" · ".join(i[at] for i in kept)) <= cols - lim - 2)
    right, right_style = joined([(i[at], i[3]) for i in shown])
    room = cols - width(right) - (2 if right else 0)
    # 左侧：产品名粗体、▸ 蓝、项目名默认色、序号灰；多项目时「▸ 项目 序号」落在深灰选中底上
    left, spans = "drover", [(0, 6, "h1")]
    if pv and room >= width(base) + min(width(name), 3):
        keep = bool(index) and (width(base + name + " " + index) <= room
                                or room - width(base + " " + index) >= min(width(name), 8))
        label = trunc(name, room - width(base) - (width(" " + index) if keep else 0))
        chip = bool(index) and {"chip", "chip_dim", "rail_mark"} <= COLORS.keys()
        start = len(left)
        left += " ▸ " + label + (" " + index if keep else "") + (" " if chip else "")
        spans += [(start, start + 1, "chip" if chip else ""), (start + 1, start + 2, "rail_mark" if chip else "accent"),
                  (start + 2, start + 3 + len(label), "chip" if chip else ""),
                  (start + 3 + len(label), len(left), "chip_dim" if chip else "account")]
        cut = label != name or index and not keep
    else:
        cut = bool(pv)
    if cut:
        full.append(("", 2, f"Project {name}" + (f" · {index}" if index else "")))
    gap = cols - width(left) - width(right)
    row1 = (left + " " * gap + right if right else left,
            ("", *spans, *((len(left) + gap + a, len(left) + gap + b, color) for a, b, color in right_style[1:])))
    if mode and any(i not in shown for i in mode):
        text, style = joined([(i[1], i[3]) for i in mode])
        full.append((style, 2, text))
    # 待处理全属当前项目时，详情开头本来就有「Needs you · N」，不再重复
    if pending and (pending not in shown or at == 2) and len(vm["waits"]) != len(pv["waits"] if pv else []):
        full.append(("wait", 2, pending[1]))
    if not health["ok"]:
        full.append(("bad", 2, health["text"]))
    # 第二行：任务状态与标题；没有当前任务只说队列处境，添加提示交给底栏 a Add
    if c:
        status = "■ Ready to release" if c["waiting"] else "▶ In progress"
        row2 = (task_heading(pv).replace("\t", "    "),
                ("h1", (0, len(status), "heading_wait" if c["waiting"] else "heading_active")))
    else:
        row2 = ("○ " + ("No registered projects" if not pv else "No task queue" if not q else
                        "No active task" if q["todo"] else "Queue empty"), "accent")
        if width(row2[0]) > cols:
            full.append(("accent", 2, row2[0]))
    # 第三行：次级信息。正常连接放不下就让到详情末尾；任务指标照旧由 draw 补完整副本
    if c:
        parts = [(m, "dim") for m in task_metrics(pv).replace("\t", "    ").split(" · ")]
    else:
        parts = [(f'HEAD {pv["head"]}', "dim")] if pv else []
    connected = [(health["text"], "ok")] if health["ok"] else []
    row3 = joined(parts + connected)
    tail = []
    if width(row3[0]) > cols and connected:  # 可退让的放详情末尾，不把正文往下挤
        row3 = joined(parts)
        tail = [("", 0, ""), ("h2", 0, "Connection"), ("ok", 2, health["text"])]
    if full:
        full = [("h2", 0, "Status")] + full + [("", 0, "")]
    return [row1, row2, row3], full, tail


def draw(stdscr, vm, state):
    """字符网格：固定摘要、主辅栏共用翻页、底部按键和消息。只写内存视口。"""
    h, w = stdscr.getmaxyx()
    stdscr.erase()
    if state.get("help"):                             # 整屏覆盖；看板的选择和各处偏移原样留着
        draw_help(stdscr, state, h, w)
        return
    ps = vm["projects"]
    if state.get("pending"):                          # 同上：只动自己的 pending_* 状态
        draw_pending(stdscr, ps[min(state.get("sel", 0), len(ps) - 1)] if ps else None, state, h, w)
        return
    sel = min(max(state.get("sel", 0), 0), len(ps) - 1) if ps else 0
    pv = ps[sel] if ps else None
    project = pv["repo"] if pv else None
    compact = h < 12
    narrow = not compact and w < 100                  # 窄面板：三行 header，项目切换并进第一行
    rail = RAIL if len(ps) > 1 and w >= 100 else 0
    x = rail + 3 if rail else 1
    cols = max(2, w - x - 1)
    top = 2 if compact else 5 if w >= 100 else 4
    bot = h - (2 if compact else 3)
    room = max(0, bot - top + 1) if h >= 5 and w >= 20 else 0
    msg = state.get("msg", "")
    msg = "" if msg == HELP else msg
    q = pv["queue"] if pv else None
    c = q["card"] if q else None
    heading_status = ("■ Ready to release" if c["waiting"] else "▶ In progress") if c else "○ Idle"
    heading_kind = ("heading_wait" if c["waiting"] else "heading_active") if c else "heading_idle"
    msg_kind = state.get("msg_kind", "wait")
    local_body = bool(c and c.get("body") and state.get("body_mouse", False))
    local_history = bool(q and q["finished"] and state.get("body_mouse", False))
    state["screen_size"] = (h, w)
    state["body_rect"] = None                         # 命中只认当帧实际可见的正文行
    state["history_rect"] = None
    if not local_body:
        for key in ("body_task", "body_offset", "body_total", "body_page"):
            state.pop(key, None)
    if not local_history:
        for key in ("history_project", "history_offset", "history_total", "history_page", "history_anchor"):
            state.pop(key, None)
    if pv:
        main, side = detail_sections(pv, body=[("body", 0, "")] if local_body else None, presentation=True,
                                     history=[("history_body", 0, "")] if local_history else None)
        if c and c.get("body") and state.get("body_mouse") is False:
            main = [("dim", 0, "Mouse wheel unavailable · PgUp/PgDn shows full task details")] + main
        # 固定摘要放不下的标题/指标仍在正文开头完整可达。
        heading, metrics = task_heading(pv), task_metrics(pv)
        heading_style = ("h1", (0, len(heading_status), heading_kind))
        metrics_style = "dim"
        if not c:
            start = len(pv["name"] + " · ")
            end = len(metrics) - len(f' · HEAD {pv["head"]}')
            metrics_style = ("dim", (start, end, status_color(pv["state"])))
        # 窄屏 header 画的是 Tab 展开后的副本，放不放得下也按展开后的宽度判断
        fits = (lambda text: width(text.replace("\t", "    ")) <= cols) if narrow else (lambda text: width(text) <= cols)
        prefix = [(heading_style, 0, heading)] if compact or not fits(heading) and (c or not narrow) else []
        if compact or not fits(metrics) and (c or not narrow):
            prefix.append((metrics_style, 0, metrics))
        message = ([(msg_kind, 0, "Operation message")]
                   + [("", 2, line) for line in msg.split("\n")] + [("", 0, "")]
                   if msg and not footer_only_message(msg, c, w - 2) else [])
        main = prefix + message + main
    else:
        heading, metrics = "○ Idle  No registered projects", "Run drover init <name> in a repository"
        metrics_style = "dim"
        main, side = [("", 0, metrics)], []
    if narrow and w >= 20:
        header, header_full, header_tail = narrow_header(vm, ps, sel, cols)
        main, side = header_full + main, side + header_tail
    dual = cols >= 100 and bool(main) and bool(side) and not compact
    left = (cols - 3) * 70 // 115 if dual else cols
    columns = [wrap_lines(main, left), wrap_lines(side, cols - left - 3)] if dual else [wrap_lines(main + side, cols)]
    if local_body:
        body = wrap_lines([("", 2, ln) if ln else ("", 0, "") for ln in c["body"]], left - 2)
        body_page = min(len(body), max(1, min(h // 4, room - 7)))
        task = (project, c["id"])
        body_offset = state.get("body_offset", 0) if state.get("body_task") == task else 0
        body_at = next(i for i, (kind, _, _) in enumerate(columns[0]) if kind == "body")
        # 先固定正文占位高度，外层排版不受局部偏移影响；当帧裁切后再填内容。
        columns[0][body_at:body_at + 1] = body[:body_page] + ([("", 0, "")] if len(body) > body_page else [])
    if local_history:
        history_col = 1 if dual else 0
        history_width = cols - left - 3 if dual else cols
        history, spans = [], {}
        for f in q["finished"]:
            rows = wrap_lines(history_lines(f, True), history_width - 2)
            spans[f["id"]] = (len(history), len(rows))
            history += rows
        history_at = next(i for i, (kind, _, _) in enumerate(columns[history_col]) if kind == "history_body")
        # 先留原外层提示的空间；入口已在首屏外时，给翻到历史后的视口留一页。
        history_room = max(1, room - int(history_at + 1 > room or (dual and len(columns[0]) > room)))
        remaining = history_room - history_at
        cap = max(1, remaining - 1 if remaining > 1 else history_room - 2)
        history_page = min(len(history), cap)
        history_offset = state.get("history_offset", 0) if state.get("history_project") == project else 0
        anchor = state.get("history_anchor")
        # 显式滚轮改了 offset 时按新位置；刷新/重排则按旧任务和记录内行恢复。
        if history_offset and anchor and anchor[2] == history_offset and anchor[0] in spans:
            at, length = spans[anchor[0]]
            history_offset = at + min(anchor[1], length - 1)
        columns[history_col][history_at:history_at + 1] = history[:history_page] + (
            [("", 0, "")] if len(history) > history_page else [])
    total = max(map(len, columns))
    offset = state.get("detail_offset", 0) if state.get("detail_project") == project else 0
    offset, page = detail_viewport(total, room, offset)
    state.update(detail_project=project, detail_offset=offset, detail_total=total, detail_room=room)
    if local_body:
        start = min(offset, max(0, len(columns[0]) - page)) if dual else offset
        first, end = max(body_at, start), min(body_at + body_page, start + page)
        visible = end - first if first < end else body_page
        body_offset = min(max(0, body_offset), len(body) - visible)
        state.update(body_task=task, body_offset=body_offset, body_total=len(body), body_page=visible)
        if first < end:
            columns[0][first:end] = body[body_offset:body_offset + visible]
            state["body_rect"] = (x, top + first - start, x + left, top + end - start)
        if len(body) > body_page:
            columns[0][body_at + body_page] = ("dim", 0, trunc(
                f"{body_offset + 1}–{body_offset + visible} / {len(body)} lines · wheel", left))
    if local_history:
        lines = columns[history_col]
        start = min(offset, max(0, len(lines) - page)) if dual else offset
        first, end = max(history_at, start), min(history_at + history_page, start + page)
        visible = end - first if first < end else history_page
        history_offset = min(max(0, history_offset), len(history) - visible)
        state.update(history_project=project, history_offset=history_offset,
                     history_total=len(history), history_page=visible)
        tid, (at, _) = next((tid, span) for tid, span in spans.items()
                           if span[0] <= history_offset < sum(span))
        state["history_anchor"] = (tid, history_offset - at, history_offset)
        if first < end:
            lines[first:end] = history[history_offset:history_offset + visible]
            hx = x + left + 3 if dual else x
            state["history_rect"] = (hx, top + first - start, hx + history_width, top + end - start)
        if len(history) > history_page:
            lines[history_at + history_page] = ("dim", 0, trunc(
                f"{history_offset + 1}–{history_offset + visible} / {len(history)} lines · wheel", history_width))
    if h < 5 or w < 20:
        put(stdscr, 0, 0, "Window too small", h, w)
        return
    head = "drover · " + (pv["name"] if pv else "0 projects")
    parts = []
    if q:
        mode = "Paused" if q["paused"] else "Explicit"
        parts.append((mode, "wait" if q["paused"] else "accent"))
    parts.append((vm["health"]["text"], "ok" if vm["health"]["ok"] else "bad"))
    if vm["waits"]:
        parts.append((f'! Needs you {len(vm["waits"])}', "wait"))
    spans = [(0, len("drover"), "h1"), (len("drover"), len("drover · "), "line"), (len("drover · "), len(head), "")]
    for text, color in parts:
        if text:
            start = len(head) + len(" · ")
            head += " · " + text
            spans += [(start - len(" · "), start, "line"), (start, len(head), color)]
    if narrow:
        for y, (line, style) in enumerate(header):
            put(stdscr, y, x, line, h, w - 1, style)
    else:
        put(stdscr, 0, 1, head, h, w - 1, ("bar", *spans))
    if rail:
        put(stdscr, 2, 1, "Projects", h, rail, "h2")
        rows = max(1, bot - 2)
        first = max(0, min(sel - rows + 1, len(ps) - rows))
        for i in range(first, min(len(ps), first + rows)):
            p = ps[i]
            label = ("▸" if i == sel else " ") + ("!" if p["needs_me"] else " ") + p["name"]
            if "rail_sel" not in COLORS:
                put(stdscr, 3 + i - first, 1, label, h, rail, "sel" if i == sel else ("wait" if p["needs_me"] else ""))
                continue
            # 只有 ! 是黄的，名字默认色；选中行底色铺满这一栏
            on = i == sel
            label += " " * max(0, rail - 1 - width(label)) if on else ""
            put(stdscr, 3 + i - first, 1, label, h, rail, ("rail_sel" if on else "", (0, 1, "rail_mark" if on else ""),
                                                          (1, 2, "rail_need" if on else "wait")))
        for y in range(2, bot + 1):
            put(stdscr, y, rail + 1, "│", h, w, "line")
        put_scrollbar(stdscr, rail + 1, 3, rows, len(ps), rows, first, h, w)
    if not compact and not narrow:
        put_heading(stdscr, top - 3, x, heading, h, w - 1, heading_status, heading_kind)
        put(stdscr, top - 2, x, metrics, h, w - 1, metrics_style)
    put(stdscr, top - 1, x, "─" * cols, h, w, "line")
    for ci, lines in enumerate(columns):
        cx = x if ci == 0 else x + left + 3
        cw = left if ci == 0 else cols - left - 3
        # 共用偏移；较短一栏夹在自己的末页，长栏继续翻，所有条目均可达。
        start = min(offset, max(0, len(lines) - page)) if dual else offset
        for i, (kind, indent, text) in enumerate(lines[start:start + page]):
            if kind == "h1":
                put_heading(stdscr, top + i, cx + indent, text, h, cx + cw, heading_status, heading_kind)
            else:
                put(stdscr, top + i, cx + indent, text, h, cx + cw, kind)
    if dual:
        for y in range(top, bot + 1):
            put(stdscr, y, x + left + 1, "│", h, w, "line")
    for region in ("body", "history"):
        if state[region + "_rect"]:
            x0, y0, x1, y1 = state[region + "_rect"]
            put_scrollbar(stdscr, x1 - 2, y0, y1 - y0, state[region + "_total"],
                          state[region + "_page"], state[region + "_offset"], h, w)
    put_scrollbar(stdscr, w - 1, top, page, total, page, offset, h, w)
    if total > room:
        hint = f"PgUp↑{offset} PgDn↓{max(0, total - offset - page)}"
        put(stdscr, bot, max(x, x + cols - width(hint)), hint, h, w - 1, "dim")  # 靠右，像滚动指示
    if not compact:
        keys = (("d", "Submit"), ("g", "Accept"), ("n", "Dispatch"), ("p", "Pause"), ("a", "Add"),
                ("u", "Up next"), ("r", "Refresh"), ("q", "Quit"), ("↑↓/jk", ""), ("PgUp/Dn", ""))
        # 放得下时项与项之间空两格（同 corral board 底栏）；放不下退回一格，不会更早截掉按键
        full = 1 + sum(width(k) + (1 + width(v) if v else 0) for k, v in keys) + 2 * (len(keys) - 1)
        sep = "  " if full <= w else " "
        key_x = 1
        for i, (key, hint) in enumerate(keys):
            if i:
                put(stdscr, h - 2, key_x, sep, h, w, "bar")
                key_x += len(sep)
            put(stdscr, h - 2, key_x, key, h, w, "key")
            key_x += width(key)
            if hint:
                put(stdscr, h - 2, key_x, " " + hint, h, w, "bar")
                key_x += 1 + width(hint)
    put(stdscr, h - 1, 1, msg.split("\n")[0].replace("\t", "    "), h, w, msg_kind if msg else "")


HELP_KEYS = (("Keys", (("↑↓ / jk", "Select project"),
                       ("d", "Submit current task for acceptance"),
                       ("g", "Accept submitted task; no dispatch"),
                       ("n", "Explicitly dispatch first Pending task"),
                       ("p", "Pause or resume sending new tasks"),
                       ("a", "Add tasks: edit queue.md in $EDITOR"),
                       ("u", "View pending tasks and their task files"),
                       ("r", "Refresh"),
                       ("?", "Show this help"),
                       ("Esc", "Close this help"),
                       ("q", "Quit"))),
             ("Scrolling", (("PgUp / PgDn", "Page through the details; in this help, page through it"),
                            ("Mouse wheel", "Scroll the task body or history under the pointer, 3 lines at a time"))))


def help_lines(cols):
    """帮助页正文：放得下就键和说明并排、说明悬挂换行；太窄就说明另起一行缩进。"""
    kw = max(width(k) for _, keys in HELP_KEYS for k, _ in keys)
    hang = cols - kw - 2 >= 16
    lines = []
    for title, keys in HELP_KEYS:
        lines.append(("h2", 0, title))
        for key, desc in keys:
            if hang:
                rows = wrap_lines([("bar", 0, desc)], cols - kw - 2)
                lines.append((("bar", (0, len(key), "key")), 0, key + " " * (kw - width(key) + 2) + rows[0][2]))
                lines += [("bar", kw + 2, text) for _, _, text in rows[1:]]
            else:
                lines.append(("key", 0, key))
                lines += wrap_lines([("bar", 2, desc)], cols)
        lines.append(("", 0, ""))
    return lines[:-1]


def draw_help(stdscr, state, h, w):
    """? 帮助页：标题、快捷键与滚动说明、底部 Esc。超出一屏时 PgUp/PgDn 翻，只动 help_offset。"""
    if h < 5 or w < 20:
        put(stdscr, 0, 0, "Window too small", h, w)
        return
    cols, room = w - 3, h - 4
    lines = help_lines(cols)
    offset, page = detail_viewport(len(lines), room, state.get("help_offset", 0))
    state.update(help_offset=offset, help_total=len(lines), help_room=room)
    put(stdscr, 0, 1, "Keyboard help", h, w - 1, "h2")
    put(stdscr, 1, 1, "─" * cols, h, w, "line")
    for i, (kind, indent, text) in enumerate(lines[offset:offset + page]):
        put(stdscr, 2 + i, 1 + indent, text, h, 1 + cols, kind)
    put_scrollbar(stdscr, w - 1, 2, page, len(lines), page, offset, h, w)
    if len(lines) > room:
        put(stdscr, 2 + page, 1, f"PgUp↑{offset} PgDn↓{len(lines) - offset - page}", h, w - 1, "dim")
    put(stdscr, h - 2, 1, "Esc", h, w, "key")
    put(stdscr, h - 2, 4, " Back", h, w, "bar")


def pending_lines(t):
    """一件待办的详情：队列条目正文；正文引用了任务文件的，接着是任务单全文或找不到的提示。"""
    lines = [("h2", 0, "Queue entry")] + [("", 2, ln) for ln in t.get("body") or []]
    tf = t.get("task_file")
    if tf:
        lines += [("", 0, ""), ("h2", 0, f'Task file · {tf["path"]}')]
        lines += ([("", 2, ln) for ln in tf["text"]] if tf["text"] is not None
                  else [("dim", 2, f'Task file not found: {tf["path"]}')])
    return lines


def draw_pending(stdscr, pv, state, h, w):
    """u 待办详情页：顶栏第几件和标题，下面正文与任务单。PgUp/PgDn 翻页，↑↓/jk 换一件。
    正在看的那件按编号（没编号按标题）记住；刷新后它没了，就停在原来的序号上。"""
    if h < 5 or w < 20:
        put(stdscr, 0, 0, "Window too small", h, w)
        return
    todo = (pv["queue"] or {}).get("todo", []) if pv else []
    keys = [t["id"] or t["title"] for t in todo]
    i = min(state.get("pending_sel", 0), max(0, len(todo) - 1))
    if state.get("pending_key") in keys and keys[i] != state["pending_key"]:   # 原序号还是它就不动，重名不跳回第一件
        i = keys.index(state["pending_key"])
    cols, room = w - 3, h - 4
    if todo:
        t = todo[i]
        title = f'Up next {i + 1}/{len(todo)}' + (" · ▸ Next" if t["next"] else "") + " · " \
            + (f'{t["id"]} ' if t["id"] else "Unnumbered ") + t["title"]
        lines = wrap_lines(pending_lines(t), cols)
    else:
        title, lines = "Up next 0/0", [("dim", 0, "No pending tasks")]
    offset, page = detail_viewport(len(lines), room, state.get("pending_offset", 0))
    state.update(pending_sel=i, pending_key=keys[i] if todo else None, pending_n=len(todo),
                 pending_offset=offset, pending_total=len(lines), pending_room=room)
    put(stdscr, 0, 1, title, h, w - 1, "h2")
    put(stdscr, 1, 1, "─" * cols, h, w, "line")
    for j, (kind, indent, text) in enumerate(lines[offset:offset + page]):
        put(stdscr, 2 + j, 1 + indent, text, h, 1 + cols, kind)
    put_scrollbar(stdscr, w - 1, 2, page, len(lines), page, offset, h, w)
    if len(lines) > room:
        put(stdscr, 2 + page, 1, f"PgUp↑{offset} PgDn↓{len(lines) - offset - page}", h, w - 1, "dim")
    x = 1
    for key, hint in (("↑↓/jk", " Prev/next"), ("PgUp/PgDn", " Scroll"), ("Esc", " Back")):
        put(stdscr, h - 2, x, key, h, w, "key")
        put(stdscr, h - 2, x + width(key), hint + "  ", h, w, "bar")
        x += width(key) + width(hint) + 2


# ============================================================ 按键
REFRESH_MS = 30000       # 没按键时多久自己刷一次。刷新等于重跑，看板不存自己的状态
HELP = "↑↓/jk select project · PgUp/PgDn scroll · d submit · g accept · n dispatch · p pause · a add · r refresh · q quit"


def init_mouse():
    """只订阅双向滚轮；缺常量或终端不支持时保留完整正文的整页翻页。"""
    up, down = getattr(curses, "BUTTON4_PRESSED", 0), getattr(curses, "BUTTON5_PRESSED", 0)
    if not up or not down:
        return False
    try:
        mask, _ = curses.mousemask(up | down)
        if mask & (up | down) == (up | down):
            curses.mouseinterval(0)
            return True
        curses.mousemask(0)
    except curses.error:
        pass
    return False


def run_drover(repo, *args, feedback=None):
    """所有写操作都转给 bin/drover —— 判据和队列的解析只能有一份实现，TUI 自己不动交接文件。
    → 给人看的一行；go 把放行状态、警告和拒绝原因前置，避免消息区只剩「核对通过」。"""
    try:
        r = subprocess.run([sys.executable, task_bin_path(), *args], cwd=repo,
                           capture_output=True, text=True, timeout=120,
                           env={**os.environ, "DROVER_BOARD_ENGLISH": "1"})
    except Exception as e:
        if feedback is not None:
            feedback["msg_kind"] = "bad"
        return f"drover {' '.join(args)} failed to start ({e})"
    if '--json' in args:
        try:
            value = json.loads(r.stdout)
            if feedback is not None:
                feedback['msg_kind'] = 'ok' if value.get('ok') else 'bad'
            if value.get('ok'):
                return f"{value['task_id']} → {value['state']}"
            return value['error']['why']
        except (ValueError, KeyError):
            return 'Invalid command response; refresh and inspect'
    out = [re.sub(r"[\t\n\v\f\r\x1c-\x1f]+", " ", l).strip(" ")
           for l in (r.stdout + r.stderr).split("\n")]
    out = [l for l in out if l]
    if feedback is not None:
        feedback["msg_kind"] = ("wait" if r.returncode in (8, 9, 10) else "bad" if r.returncode else
                                "wait" if any(l.startswith(("↑ ", "WARNING:")) for l in out) else "ok")
    if args == ("go",) and out:
        out.sort(key=lambda l: not l.startswith(("↑ ", "- ")))
        return ("Released" if r.returncode == 0 else "Not released") + " · " + " · ".join(out)
    return out[0] if out else f"drover {' '.join(args)}: exit {r.returncode}"


def edit_queue(stdscr, pv):
    """加任务 = 拿 $EDITOR 编这个项目的 queue.md，关掉就生效。队列本来就是个 markdown 文件，
    在看板里重新实现一个文本编辑器没有意义（网页版那个带实时预览的编辑框正是那么长出来的）。"""
    path = os.path.join(pv["dir"], "queue.md")
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
    curses.endwin()
    try:
        subprocess.call(f'{editor} "{path}"', shell=True)     # EDITOR 可能带参数，过一层 shell
    finally:
        stdscr.clear()
        stdscr.refresh()
        curses.curs_set(0)
    return f"Finished editing {path}"


def key_action(k, pv, state, mouse=None):
    """按了什么键 → 要做什么。**纯函数**：不碰 curses、不跑命令、不改 state。

    「推进靠按键，不靠敲命令」是看板的主操作面（ROADMAP），所以这一层和 view_model 一样
    单拆出来：喂键码就能验，尤其是 p 和 l ——它们按当前状态决定发哪一条，切反了就是真 bug。
    tui() 那边只剩 getch 和执行。

    state 里读 sel（选中第几个）、n（一共几个项目），以及 draw 当帧写入的详情视口。
    mouse 是 getmouse 的事件副本；只认当帧正文/历史坐标内的上下滚轮，最多三行，不更改外层偏移。
    → ("sel", 新下标) | ("scroll", 新偏移) | ("body_scroll", 正文偏移) | ("history_scroll", 历史偏移) | ("run", [drover 的参数…]) | ("edit",) | ("quit",) | ("refresh",)
      | ("help", 开/关) | ("help_scroll", 帮助页偏移)
      | ("pending", 开/关) | ("pending_sel", 第几件待办) | ("pending_scroll", 待办详情偏移) | ("note", 消息) | None
      None = 这个键不认识，或者压根没有选中的项目：什么都不做，**也不重跑**——重跑要跑一圈
      git 和 corral，不能乱按一下就触发。"""
    sel, n = state.get("sel", 0), state.get("n", 0)
    if state.get("help"):                                     # 帮助页只认关闭、翻页、刷新和退出，操作键一律不发
        if k in (27, ord("?")):
            return ("help", False)
        if k in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            return ("help_scroll", detail_viewport(state.get("help_total", 0), state.get("help_room", 0),
                                                   state.get("help_offset", 0),
                                                   1 if k == curses.KEY_NPAGE else -1)[0])
        if k not in (ord("q"), ord("r"), -1, curses.KEY_RESIZE):
            return None
    elif state.get("pending"):                                # 待办详情页同理：只认返回、换一件、翻页、刷新和退出
        if k == 27:
            return ("pending", False)
        if k in (curses.KEY_UP, ord("k"), curses.KEY_DOWN, ord("j")):
            i = state.get("pending_sel", 0) + (-1 if k in (curses.KEY_UP, ord("k")) else 1)
            return ("pending_sel", i) if 0 <= i < state.get("pending_n", 0) else None   # 到头就停
        if k in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            return ("pending_scroll", detail_viewport(state.get("pending_total", 0), state.get("pending_room", 0),
                                                      state.get("pending_offset", 0),
                                                      1 if k == curses.KEY_NPAGE else -1)[0])
        if k not in (ord("q"), ord("r"), -1, curses.KEY_RESIZE):
            return None
    elif k == ord("?"):
        return ("help", True)
    elif k == ord("u") and pv:
        return ("pending", True) if (pv["queue"] or {}).get("todo") else ("note", "No pending tasks")
    if k == curses.KEY_MOUSE:
        if not mouse or not pv:
            return None
        _, x, y, _, buttons = mouse
        up, down = getattr(curses, "BUTTON4_PRESSED", 0), getattr(curses, "BUTTON5_PRESSED", 0)
        if not up or not down or buttons not in (up, down):
            return None
        for region in ("body", "history"):
            rect = state.get(region + "_rect")
            if not rect:
                continue
            x0, y0, x1, y1 = rect
            if x0 <= x < x1 and y0 <= y < y1:
                step = min(3, y1 - y0)              # 极小/被裁切的视口不跨过未显示的行
                offset = state[region + "_offset"] + (step if buttons == down else -step)
                return (region + "_scroll", min(max(0, offset), state[region + "_total"] - state[region + "_page"]))
        return None
    if k in (curses.KEY_UP, ord("k")):
        return ("sel", max(0, sel - 1))
    if k in (curses.KEY_DOWN, ord("j")):
        return ("sel", min(n - 1, sel + 1) if n else 0)
    if k == ord("q"):
        return ("quit",)
    if k in (ord("r"), -1, curses.KEY_RESIZE):                # -1 = getch 超时，没人按键，自己刷一次
        return ("refresh",)
    if not pv:
        return None
    if k in (curses.KEY_NPAGE, curses.KEY_PPAGE):
        offset, _ = detail_viewport(state.get("detail_total", 0), state.get("detail_room", 0),
                                    state.get("detail_offset", 0),
                                    1 if k == curses.KEY_NPAGE else -1)
        return ("scroll", offset)
    if k == ord("a"):
        return ("edit",)
    q = pv['queue'] or {}
    if k == ord('p'):
        return ('run', ['resume' if q.get('paused') else 'pause'])
    action = {ord('d'): 'done', ord('g'): 'go', ord('n'): 'dispatch-pending'}.get(k)
    if not action:
        return None
    t = ((q.get('todo') or [None])[0] if action == 'dispatch-pending' else q.get('card'))
    target = (t or {}).get('actions', {}).get(action)
    if not target or not target.get('target_token'):
        return ('note', 'Action unavailable; refresh and inspect the task state')
    args = ([action, '--pos', str(target['pos'])] if action == 'dispatch-pending' else [action, t['id']])
    return ('run', [*args, '--target-token', target['target_token'], '--json'])


def tui(stdscr, list_path):
    curses.curs_set(0)
    if hasattr(curses, "set_escdelay"):
        curses.set_escdelay(25)                               # Esc 默认要等一秒才认
    init_colors()
    stdscr.timeout(REFRESH_MS)
    vm = view_model(collect(list_path))
    state = {"sel": 0, "n": len(vm["projects"]), "msg": HELP, "body_mouse": init_mouse()}
    while True:
        draw(stdscr, vm, state)
        stdscr.refresh()
        try:
            k = stdscr.getch()
        except KeyboardInterrupt:
            return
        ps = vm["projects"]
        pv = ps[min(state["sel"], len(ps) - 1)] if ps else None
        mouse = None
        if k == curses.KEY_MOUSE:
            try:
                mouse = curses.getmouse()
            except curses.error:
                continue
            if stdscr.getmaxyx() != state["screen_size"]:
                continue                             # 缩放夹在绘制和输入之间：丢弃旧坐标，再重绘
        act = key_action(k, pv, state, mouse)
        if not act:
            continue
        if act[0] == "quit":
            return
        if act[0] == "sel":
            state["sel"] = act[1]
            continue
        if act[0] == "scroll":
            state["detail_offset"] = act[1]
            continue
        if act[0] == "help":
            state.update(help=act[1], help_offset=0)
            continue
        if act[0] == "help_scroll":
            state["help_offset"] = act[1]
            continue
        if act[0] == "pending":
            state.update(pending=act[1], pending_sel=0, pending_key=None, pending_offset=0)
            continue
        if act[0] == "pending_sel":
            state.update(pending_sel=act[1], pending_key=None, pending_offset=0)
            continue
        if act[0] == "pending_scroll":
            state["pending_offset"] = act[1]
            continue
        if act[0] == "note":
            state.update(msg=act[1], msg_kind="")
            continue
        if act[0] in ("body_scroll", "history_scroll"):
            state[act[0].replace("_scroll", "_offset")] = act[1]
            continue
        if act[0] == "edit":
            state["msg"] = edit_queue(stdscr, pv)
            state["msg_kind"] = ""
        elif act[0] == "run":
            state["msg"] = run_drover(pv["repo"], *act[1], feedback=state)
        else:
            state["msg"] = HELP                               # refresh：消息栏还原成按键提示
        vm = view_model(collect(list_path))                   # 刷新等于重跑
        state["n"] = len(vm["projects"])


# ============================================================ 外层循环的一跳
def task_bin_path():
    """和看板装在一起的那个 drover。两个工具必须成对，不然解析交接文件的函数对不上。"""
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "drover")


CHECK_EVERY = 300       # 两次完整核对之间至少隔这么久。第 3 条可能是整套测试，不能每跳都跑


# ============================================================ 入口
def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"], ["help"]):
        print(__doc__.strip())
        return
    list_path, rest = None, list(args)
    while rest:
        a = rest.pop(0)
        if a == "--projects" and rest:
            list_path = rest.pop(0)
        else:
            print(f"Unknown argument: {a}\n\n{__doc__.strip()}")
            sys.exit(2)
    if not sys.stdout.isatty():
        print("drover board requires an interactive terminal.")
        sys.exit(2)
    curses.wrapper(tui, list_path)


if __name__ == "__main__":
    main()
