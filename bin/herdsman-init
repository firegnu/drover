#!/usr/bin/env bash
# 在当前 git 仓库里接入 drover。
# 用法： herdsman-init <短名>
#
# 幂等：已存在的东西不覆盖，只报告。
# 只写两个东西：仓库里的 .drover.conf（加进 .gitignore）和 ~/.drover/ 下的交接目录与项目清单。
# 不建 worktree、不开 agent、不碰目标仓库的任何源码——那些都是内循环和人的事。
set -uo pipefail

SHORT="${1:-}"
[ -n "${SHORT}" ] || { echo "用法: herdsman-init <短名>   例如: herdsman-init inksample"; exit 2; }
case "${SHORT}" in
  *[!a-z0-9-]*) echo "ERROR: 短名只允许小写字母、数字和连字符"; exit 2;;
esac

command -v git >/dev/null || { echo "ERROR: 缺 git"; exit 2; }
REPO=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "ERROR: 不在 git 仓库中"; exit 2; }
cd "${REPO}"

RDIR="${HOME}/.drover/${SHORT}"

echo "仓库:     ${REPO}"
echo "交接目录: ${RDIR}"
echo

# ---- 1. .drover.conf ----
if [ -f .drover.conf ]; then
  echo "  = .drover.conf 已存在，跳过（如需改动请手动编辑）"
else
  cat > .drover.conf <<EOF
# drover 的项目配置。一行一个 \`键=值\`，# 开头是注释。这个文件不进 git。

# 交接目录：queue.md（归人）和 tasks.state（归 drover）都在这里。
HANDOFF_DIR=${RDIR}

# 主控的 corral 名字，\`corral ls\` 里看得到的那个。drover 只对它 send / status，
# 不开、不关、不接入。留空就是还没接上 corral，drover 不会送任务。
MAIN_AGENT=

# 里程碑分支的匹配模式，原样交给 \`git branch --list\`。完成判据第 2 条用它找分支，
# 再逐个问「合进 main 了没有」。留空 = 这个项目不用里程碑分支，第 2 条跳过。
# 真实项目长这样：owlet 是 m8-2-backend，jb-finetune 是 m3/implementation，
# 两边都能用 \`m[0-9]*\` 匹配到。别写 \`m*\` —— 它会把 main 自己也匹配进来。
# 匹配到 0 个分支时第 2 条判**不过**（不是空过），因为「写错了」和「没建分支」从 git 看一样。
BRANCH_GLOB=

# 默认验收命令。完成判据第 3 条跑它，退出码 0 才算过。队列条目可以覆盖。
# 例：CHECK_CMD=uv run pytest -q
CHECK_CMD=

# 放行模式：1（默认）每个任务做完等人 go；0 自动模式，做完直接发下一个。
# TASK_GATE=1
EOF
  echo "  ✓ 写好 .drover.conf"
fi

touch .gitignore
grep -qxF '.drover.conf' .gitignore || { echo '.drover.conf' >> .gitignore; echo "  ✓ .drover.conf 加入 .gitignore"; }

# ---- 2. 登记给看板：仓库不在 ~/Developer/personal_projs 下也能被 review-board 扫到 ----
mkdir -p "${HOME}/.drover"
grep -qxF "${REPO}" "${HOME}/.drover/projects" 2>/dev/null \
  || { echo "${REPO}" >> "${HOME}/.drover/projects"; echo "  ✓ 登记到 ~/.drover/projects（看板项目清单）"; }

# ---- 3. 交接目录 ----
mkdir -p "${RDIR}"
echo "  ✓ 交接目录就绪"

echo
echo "接好了。往 ${RDIR}/queue.md 里写任务（格式见 docs/queue-example.md），"
echo "或者直接跑：review-task add \"标题\" [说明行 …]"
