#!/usr/bin/env python3
"""drover —— 外层循环的队列：人往 queue.md 里写任务，本工具一件接一件送进主控。

**这是 drover 侧的工具，不在主控里跑。** 它做的只有两件事（见 ROADMAP「全部动作」）：
用 `corral send` 往主控送一句话（任务正文），以及只读核对 git。送出去的就是任务正文本身，
和人手动粘一段任务进去一模一样——主控甚至不需要知道有 drover 这个东西。
不启动、不关闭、也不接入任何 agent。**对目标仓库完全只读**——一个字节都不写。
  queue.md    交接目录里，只归人。「## T7 标题」或「## 标题」开一块，下面随意写约束和验收；
              编号可省（发出时补上），文件里的先后就是执行顺序。
  tasks.state 交接目录里，只归本工具。每行一个 JSON 事件（start / done / go / drop），只追加。
「做完了」由本工具只读核对 git，不听主控一句话。交接文件的解析和三条判据都复用看板
（drover-board）里的函数，两边用同一套。

在仓库目录里运行：
  drover init <短名>             人：把这个仓库接上 drover（写 .drover.conf、建交接目录、登记）
  drover board                   打开看板（curses TUI；参数原样转给 drover-board，见它的 --help）
  drover add "标题" [说明行 …]   人：加到队列末尾，自动编号
  drover list                    看进行中、队列、已完成
  drover next                    把下一件送进主控；有进行中的就重发它
  drover done T5                 只读核对三条判据；通过后停下等放行，或直接发下一件
  drover go                      人：核对并记完成、放行；已完成的只放行，不发下一件
  drover drop T5 "原因"          人：放弃一个任务（进行中的，或队列里还没开始的）
  drover drop --pos 3 "原因" [--expect V]   人：按队列位置放弃还没开始的任务，没编号的也行（编号记进 tasks.state，按标题认）
  drover pause | resume          人：暂停 / 恢复发新任务，正在做的照常做完
  drover loop on | off           人：这个项目的外层循环开 / 关（交接目录里的 loop 文件，默认没有 = 关）。开着时
                                      主控空闲下来就核对判据、自己记 done；下一件发不发看 TASK_GATE。
                                      停在队列那一步（队列空 / 暂停 / 等放行 / 主控在忙）时留下 .loop-wait，引擎再跑一次 next
  drover loop [--once] [--interval 秒] [--projects F]
                                 引擎本身：把 ~/.drover/projects 里开着循环的项目各跑一跳。默认常驻，
                                      --once 跑一跳就退出。它是唯一推动外层循环的东西，看板开不开都不影响
  drover hold 3 on|off [--expect V]   人：「做完停」—— 队列里第 3 个还没开始的任务做完后停下等放行，不管什么模式
                                      （记进 tasks.state，不改 queue.md；正文里写一行「做完：等我放行」效果一样）
  drover move 4 1 [--expect V]   人：把队列里第 4 个还没开始的任务挪到第 1 个（位置同 list 里「队列」的序号）
  drover edit 2 "标题" [说明行 …] [--expect V]   人：整块改写第 2 个还没开始的任务，编号不变
                                      --expect：queue.md 的指纹，对不上说明队列刚被改过，不写（move / edit / drop --pos）
退出码：0 送达或操作成功；8 停下了（队列空、暂停、等放行、主控在忙 / 不在 / 有人在打字）；9 判据没满足；
        2 用法或前置条件不满足；10 队列在这期间被改过（--expect 对不上），什么都没写。
配置见 .drover.conf：MAIN_AGENT 送给谁（空 = 不自动送，打出来让人粘）、TASK_GATE 放行模式、
CHECK_CMD 是完成判据第 3 条跑的命令（留空 = 不跑验收）。
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time

sys.dont_write_bytecode = True   # 下面按文件路径加载看板；别在 bin/ 里留下 __pycache__


def print_text(text):
    """只在输出时转义代理码；任务正文和判据理由仍保留原字符。"""
    print(re.sub(r"[\ud800-\udfff]", lambda m: f"\\u{ord(m[0]):04x}", text))


def die(code, msg):
    print(msg)
    sys.exit(code)


def stop(msg):
    print(msg)
    return 8


def load_board():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "drover-board")
    if not os.path.exists(path):
        die(2, f"ERROR: 找不到 {path}。drover 用看板的函数读交接文件和算判据，两个文件必须装在同一个目录里。")
    loader = importlib.machinery.SourceFileLoader("drover_board", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("drover_board", loader))
    loader.exec_module(mod)
    return mod


B = load_board()
REPO = D = Q = S = PAUSED = LOOP = DONE_MARK = ""
GATE = True


def setup():
    global REPO, D, Q, S, PAUSED, LOOP, GATE, CHECK_CMD, MAIN_AGENT, DONE_MARK
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if r.returncode:
        die(2, "ERROR: 不在 git 仓库里。到项目目录里运行 drover。")
    REPO = r.stdout.strip()
    conf = B.parse_conf(f"{REPO}/.drover.conf")
    if not conf.get("HANDOFF_DIR"):
        die(2, f"ERROR: {REPO}/.drover.conf 缺失或没有 HANDOFF_DIR，这个仓库还没接入 drover。")
    D = conf["HANDOFF_DIR"]
    os.makedirs(D, exist_ok=True)
    Q, S, PAUSED, LOOP = f"{D}/queue.md", f"{D}/tasks.state", f"{D}/paused", f"{D}/loop"
    GATE = conf.get("TASK_GATE", "1").strip() != "0"
    CHECK_CMD = conf.get("CHECK_CMD", "")            # 判据第 3 条跑的命令；留空 = 这个项目不跑验收
    MAIN_AGENT = conf.get("MAIN_AGENT", "")          # 送给谁；空 = 不自动送，打出来让人粘
    DONE_MARK = conf.get("DONE_MARK", "收尾").strip()  # 收尾记号的前缀；空 = 这个项目不打记号，判不出完成


def sh(*args):
    return subprocess.run(["git", "-c", "core.quotepath=false", "-C", REPO, *args], capture_output=True, text=True)


def git(*args):
    return sh(*args).stdout


def head():
    return git("rev-parse", "HEAD").strip()


def main_sha():
    """送任务之前 main 停在哪。判据第 1 条拿它比——不能用 HEAD，仓库不一定在 main 上。"""
    return git("rev-parse", B.MAIN_BRANCH).strip()


# ============================================================ 队列（人的）与进度（本工具的）
# 解析放在看板里（task_blocks / task_events / task_fold / task_pending），看板显示的和这里发出去的是同一个队列。
def parse_queue():
    return B.task_blocks(B.read(Q))


def append(ev):
    with open(S, "a", encoding="utf-8") as f:
        f.write(json.dumps({"t": int(time.time()), **ev}, ensure_ascii=False) + "\n")


def fold():
    """→ ({id: task}（按开始顺序）, 进行中的那个, 在等放行的 id)"""
    return B.task_fold(B.task_events(B.read(S)))


def pending(tasks):
    return B.task_pending(parse_queue(), tasks)


def next_num():
    ids = [b["id"] for b in parse_queue() if b["id"]] + list(fold()[0])
    return max([int(i[1:]) for i in ids if re.fullmatch(r"T\d+", i or "")], default=0) + 1


def start_task(t, again):
    """记下「这件活发出去了」。**只在真的送达之后才调**——corral 拒绝送（主控在忙、有人在打字、
    主控不在）时一个字都不能写，否则队列里会留下一件主控从没收到的「进行中」任务。
    again 是重发进行中的那件，它早就有 start 事件了，不再记一条。"""
    if not again:
        append({"ev": "start", "id": t["id"], "title": t["title"], "body": t.get("body", ""), "key": t["title"],
                "sha": head(), "main": main_sha()})
    if os.path.exists(f"{D}/.loop-wait"):
        os.remove(f"{D}/.loop-wait")             # 发出去了：停下的标记作废
    return 0


def task_text(t, again=False):
    """送进主控的那段话 —— 就是任务正文本身，和人手动粘一段任务进去一模一样。

    **这里绝不能出现「运行 drover …」这类话。** 老 herdsman 往写手窗格里注入的是
    「运行 review-task next，按它的输出办」，那是内循环依赖外循环；drover 送任务正文，
    主控甚至不需要知道有 drover 这个东西（见 ROADMAP「全部动作」）。"""
    out = [f"TASK {t['id']}: {t['title']}"]
    if t.get("body"):
        out += ["", t["body"]]
    if again:
        out += ["", "（这件活之前发过，接着做；进度都在 git 里。）"]
    return "\n".join(out)


def issue(t, again=False):
    """把任务送进主控。没配 MAIN_AGENT 就打出来让人自己粘 —— 内循环全靠人手工做的项目，
    drover 照样能用，只是少了自动送这一步（ROADMAP「怎么算成功」里那条依赖方向的验证）。"""
    text = task_text(t, again)
    if not MAIN_AGENT:
        print_text(text)
        print("\n（没配 MAIN_AGENT：上面这段没有送出去，自己粘给主控。）")
        return start_task(t, again)
    code, j = B.corral("send", MAIN_AGENT, text, timeout=60)
    if code == 0:
        rc = start_task(t, again)
        extra = "（和人留的草稿拼在一起提交了，去看一眼）" if j.get("merged_with_draft") else ""
        print(f"已送给 {MAIN_AGENT}：{t['id']} {t['title']}{extra}")
        return rc
    if code == B.CORRAL_NOT_DELIVERED:
        # 契约：corral 不补发任何按键，**不要重送**。可能已经到了，所以照样记开始，
        # 但要显眼地报出来让人去看一眼——这是唯一一种「状态真的不确定」的情况。
        start_task(t, again)
        print(f"送了但没确认送达：{t['id']} 已按发出记账，不会重送。去 {MAIN_AGENT} 那边看一眼收到没有。")
        return 8
    why = {B.CORRAL_NOT_FOUND: f"corral 里没有 {MAIN_AGENT}（主控没开，或者名字配错了）。drover 不会替你开它。",
           B.CORRAL_NOT_IDLE: f"{MAIN_AGENT} 不是 idle（{j.get('state', '?')}），它正忙：等它这一轮结束再送。",
           B.CORRAL_HUMAN_ACTIVE: f"最近 30 秒有人在 {MAIN_AGENT} 的接入窗口里操作：让着人，等会儿再送。",
           }.get(code, f"corral send 退出码 {code}：{j.get('message', '')}")
    return loop_stop("blocked", f"STOP: {t['id']} 没送出去。{why}")


# ============================================================ 「做完了」的核对（只读）
def tree_dirty():
    return [l[3:].split(" -> ")[-1] for l in git("status", "--porcelain", "--untracked-files=no").splitlines()]


def check_done(task):
    """→ (问题列表, 同次核对的三条门)。只读核对 git，不听主控一句话。
    三条门见 docs/ROADMAP.md；求值在 drover-board.criteria 里，看板和这里用同一份。
    「不适用」的那几条（没有 base_sha、没有验收命令）不算不过，但会照原样报出来——
    3 条里过了几条要看得见，不能让跳过的悄悄混成通过。

    **收尾记号（依据）不在这里拦。** 手动 `drover go` / `done` 是人在说「这件活完了」，drover 只报告
    自己有没有认出来（见 criteria_report）。自动那条路由 drover-board.close_if_done 卡死：
    见不到记号就不跑到这里来。"""
    probs = []
    dirty = tree_dirty()
    if dirty:
        probs.append("工作区有没提交的改动：" + "、".join(dirty[:5]) + (" 等" if len(dirty) > 5 else ""))
    cmd, sha = CHECK_CMD, main_sha()
    rows = B.criteria(REPO, task.get("main", ""), cmd)
    # 发布和报告都复用决定能否 done 的这次核对。
    check = next(r for r in rows if r["n"] == 3)
    mark = f"{D}/.check-result"
    tmp = f"{mark}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"task": task["id"], "main": sha, "cmd": cmd, "ok": check["ok"],
                       "why": check["why"], "t": int(time.time())}, f, ensure_ascii=False)
        os.replace(tmp, mark)
    except (OSError, UnicodeError) as e:
        # 显示记录是可失败的旁路，不能成为完成判断或队列推进的新前提。
        print(f"WARNING: 未能发布 {mark}：{e}", file=sys.stderr)
    for r in rows:
        if r["ok"] is False:
            probs.append(f'判据 {r["n"]}（{r["name"]}）没满足：{r["why"]}')
    return probs, rows


def done_mark_row(task):
    """收尾记号：判「这件活完了」的唯一依据。求值在 drover-board.find_done_mark 里。"""
    return B.find_done_mark(REPO, task.get("main", ""), DONE_MARK)


def criteria_report(task, rows):
    """依据（收尾记号）+ 三条门各自什么状态，原样打给人看。跳过的也要出现。

    依据不满足时**照样打，不拦**：手动 `drover go` / `done` 是人在说「这件活完了」，drover 没资格
    拦人。它只负责把「我没认出完成」说清楚。自动那条路是另一回事——循环引擎见不到记号就
    不会走到这里（drover-board.close_if_done）。"""
    out = []
    for r in [done_mark_row(task)] + rows:
        mark = "✓" if r["ok"] else ("—" if r["ok"] is None else "✗")
        out.append(f'  {mark} {r["n"] or "依据"} {r["name"]}：{r["why"]}')
    return out


# ============================================================ 命令
def split_blocks(text):
    """queue.md → (第一个 ## 之前的前言, [每块的原文])；和看板的 task_blocks 用同一个标题行判据，逐行原样保留。"""
    pre, blocks = [], []
    for line in (text or "").splitlines(keepends=True):
        if B.TASK_HDR.match(line.rstrip("\r\n")):
            blocks.append([line])
        elif blocks:
            blocks[-1].append(line)
        else:
            pre.append(line)
    return "".join(pre), ["".join(b) for b in blocks]


def join_blocks(pre, blocks):
    """块之间至少隔一个空行；只补缺的，不动原有的空行。"""
    out = pre
    for i, b in enumerate(blocks):
        if out and not out.endswith("\n"):
            out += "\n"
        if i and not out.endswith("\n\n"):
            out += "\n"
        out += b
    return out if out.endswith("\n") else out + "\n"


def write_queue(text):
    """先写临时文件再整体替换：写手这时运行 next 读到的要么是旧的，要么是新的，不会是半个。"""
    tmp = f"{Q}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, Q)


def pending_slots(expect):
    """→ (前言, 各块原文, 待办块在各块里的下标)。--expect 对不上直接退出 10。"""
    text = B.read(Q) or ""
    if expect and expect != B.queue_version(text):
        die(10, "CONFLICT: queue.md 在这期间被改过（别人刚加了或改了任务），什么都没写。刷新后再操作。")
    pre, raw = split_blocks(text)
    parsed = [B.task_blocks(r)[0] for r in raw]
    todo = B.task_pending(parsed, fold()[0])
    return pre, raw, [next(i for i, b in enumerate(parsed) if b is t) for t in todo]


def check_task_text(title, notes):
    if not title or "\n" in title:
        die(2, "ERROR: 标题要是一行非空的文字")
    bad = [n for n in notes if B.TASK_HDR.match(n)]
    if bad:
        die(2, f"ERROR: 说明里顶格的「## 」会被当成另一个任务：{bad[0]}；小标题请用 ###")


def slot(pos, slots):
    if not re.fullmatch(r"\d+", pos or "") or not 1 <= int(pos) <= len(slots):
        die(2, f"ERROR: 位置要是 1 到 {len(slots)} 之间的数字（队列里还没开始的任务按顺序数），现在是 {pos}")
    return int(pos) - 1


def cmd_move(src, dst, expect):
    pre, raw, slots = pending_slots(expect)
    a, b = slot(src, slots), slot(dst, slots)
    if a == b:
        print("位置没变。")
        return 0
    order = [raw[i].rstrip("\r\n") + "\n" for i in slots]   # 挪动的块去掉尾部空行，块间空行由 join_blocks 统一补
    block = order.pop(a)
    order.insert(b, block)
    for i, r in zip(slots, order):          # 待办块只在自己原来占的那几个位置里换，前言和开始过的块不动
        raw[i] = r
    write_queue(join_blocks(pre, [r if r.endswith("\n") else r + "\n" for r in raw]))
    t = B.task_blocks(block)[0]
    print(f"已把 {t['id'] or '（未编号）'} {t['title']} 挪到队列第 {b + 1} 个。")
    return 0


def cmd_edit(pos, title, notes, expect):
    title = title.strip()
    check_task_text(title, notes)
    pre, raw, slots = pending_slots(expect)
    i = slots[slot(pos, slots)]
    old = B.task_blocks(raw[i])[0]
    raw[i] = f"## {old['id'] + ' ' if old['id'] else ''}{title}\n" + "".join(n.rstrip("\n") + "\n" for n in notes)
    write_queue(join_blocks(pre, [r if r.endswith("\n") else r + "\n" for r in raw]))
    print(f"已改写队列第 {int(pos)} 个：{old['id'] or '（未编号）'} {title}")
    return 0


def cmd_add(title, notes):
    title = title.strip()
    if not title or "\n" in title:
        die(2, "ERROR: 标题要是一行非空的文字")
    tid = f"T{next_num()}"
    text = B.read(Q) or ""
    sep = "" if not text or text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
    with open(Q, "a", encoding="utf-8") as f:
        f.write(sep + f"## {tid} {title}\n" + "".join(n.rstrip("\n") + "\n" for n in notes))
    print(f"已加入队列末尾 {tid}：{title}")
    return 0


def loop_on():
    return os.path.exists(LOOP)


def mark_loop_wait(reason):
    """留下队列推进标记，下一件由引擎调用 next。"""
    mark = f"{D}/.loop-wait"
    tmp = f"{mark}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"reason": reason, "t": int(time.time())}, f, ensure_ascii=False)
    os.replace(tmp, mark)


def loop_stop(reason, msg):
    """停在队列那一步（队列空 / 暂停 / 等放行）。循环开着时留下标记，引擎（`drover loop`）
    等条件重新满足就再跑一次 next。标记里只有原因和时间——要送给谁看配置里的 MAIN_AGENT，
    不需要记 pane，也不需要核对 pane 的身份（那是老 herdsman 往写手窗格里注入时才要的）。"""
    if loop_on():
        mark_loop_wait(reason)
        return stop(msg + "（循环开着：条件满足后会自动接着往下发。）")
    return stop(msg)


def cmd_next():
    tasks, current, awaiting = fold()
    if current:
        return issue(current, again=True)
    if os.path.exists(PAUSED):
        return loop_stop("paused", "PAUSED: 队列已暂停，不发新任务。停下，把这句报告给人；人运行 drover resume 之后，再运行 drover next。")
    if awaiting:
        return loop_stop("release", f"WAIT: {awaiting} 已完成，放行模式下要等人放行。停下，把这句报告给人；人运行 drover go 之后，再运行 drover next。")
    todo = pending(tasks)
    if not todo:
        return loop_stop("empty", f"EMPTY: 队列空了，没有新任务。往 {Q} 里加了任务之后会自动接着发。")
    b = todo[0]
    return issue({"id": b["id"] or f"T{next_num()}", "title": b["title"], "body": b["body"]})


def record_done(current, retry):
    """核对一次、报告并记完成；返回 (gate, held)，失败返回 None，不推进下一件。"""
    tid = current["id"]
    probs, rows = check_done(current)
    if probs:
        print(f"NOT DONE: {tid} 还没收尾：")
        for p in probs:
            print_text(f"  - {p}")
        print(f"处理完再运行 {retry}。")
        return None
    print(f"核对通过 {tid}：")
    for line in criteria_report(current, rows):
        print_text(line)
    if done_mark_row(current)["ok"] is not True:
        print("  ↑ 没看到收尾记号，这次算你自己判断的——循环开着时不会自动走到这一步。")
    held =B.task_held(current, B.task_holds(B.task_events(B.read(S))))
    gate = GATE or held                          # 循环开不开都听 TASK_GATE；打了「做完停」的不管什么模式都停
    append({"ev": "done", "id": tid, "sha": head(), "gate": gate})
    return gate, held


def cmd_done(tid):
    tasks, current, awaiting = fold()
    if not current or current["id"] != tid:
        die(2, f"ERROR: {tid} 不是进行中的任务" + (f"，进行中的是 {current['id']}" if current else "，现在没有进行中的任务"))
    result = record_done(current, f"drover done {tid}")
    if result is None:
        return 9
    gate, held = result
    if gate and loop_on():
        why = "人标了「做完停」" if held else "放行模式"
        return loop_stop("release", f"DONE {tid}：核对通过。{why}：等人放行（drover go）。")
    if gate:
        return stop(f"DONE {tid}：核对通过。放行模式：等人放行（drover go）。")
    print(f"DONE {tid}：核对通过。")
    return cmd_next()


def cmd_go():
    _, current, awaiting = fold()
    if current:
        if record_done(current, "drover go") is None:
            return 9
        awaiting = current["id"]
        if loop_on():
            mark_loop_wait("release")
    if not awaiting:
        die(2, "ERROR: 没有在等放行的任务")
    append({"ev": "go", "id": awaiting})
    print(f"已放行（{awaiting} 之后）。" + ("循环开着：下一件会自动送进主控。" if loop_on()
                                          else "运行 drover next 发下一件。"))
    return 0


def cmd_drop(tid, reason):
    tasks, _, _ = fold()
    t = tasks.get(tid)
    if t and t["status"] != "doing":
        die(2, f"ERROR: {tid} 已经{'完成' if t['status'] == 'done' else '放弃'}了")
    if not t:
        b = next((b for b in parse_queue() if b["id"] == tid), None)
        if not b:
            die(2, f"ERROR: 找不到 {tid}：它不在进行中，队列里也没有这个编号")
        t = {"title": b["title"], "key": b["title"]}
    append({"ev": "drop", "id": tid, "title": t["title"], "key": t.get("key") or t["title"], "reason": reason})
    print(f"已放弃 {tid}：{t['title']}" + (f"（{reason}）" if reason else ""))
    return 0


def cmd_drop_pos(pos, reason, expect):
    """按队列位置放弃还没开始的任务。有编号走 cmd_drop；没编号的在 tasks.state 里给个编号、以标题为 key 记下，
    task_pending 按标题认出它已放弃（和 next 发没编号的任务同一个办法）；queue.md 原文不动。"""
    _, raw, slots = pending_slots(expect)
    b = B.task_blocks(raw[slots[slot(pos, slots)]])[0]
    if b["id"]:
        return cmd_drop(b["id"], reason)
    tid = f"T{next_num()}"
    append({"ev": "drop", "id": tid, "title": b["title"], "key": b["title"], "reason": reason})
    print(f"已放弃 {tid}：{b['title']}" + (f"（{reason}）" if reason else "")
          + "。queue.md 里这块没编号，按标题认：之后再手写同名的没编号任务也会被当成已放弃，换个标题或加上编号。")
    return 0


def cmd_hold(pos, on, expect):
    _, raw, slots = pending_slots(expect)
    b = B.task_blocks(raw[slots[slot(pos, slots)]])[0]
    append({"ev": "hold", "key": b["id"] or b["title"], "title": b["title"], "on": on})
    print(f"{'已标' if on else '已取消'}「做完停」：{b['id'] or '（未编号）'} {b['title']}"
          + ("。它做完后会停下等放行，不管是不是开着循环。" if on else "。"))
    return 0


# ============================================================ 系统通知
# 通知跟着守护进程走，和界面无关：引擎每跳发一次，看板开不开都照发。以前它挂在看板的静态生成
# 路径上（`drover-board --notify`，由 launchd 定时调），看板改成前台 TUI 之后那条路就没了。
NOTIFY_BIN = os.environ.get("DROVER_NOTIFY_BIN", "osascript")
NOTIFY_STATE = os.path.expanduser("~/.drover/board-notified.json")


def applescript_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def notify_new(projects, state_path):
    """新出现的「等你」条目弹 macOS 通知：一个项目一条，写有几条新的和第一条的内容。
    已通知过的 key 记在 state_path；条目解决后从记录里消失，再出现会重新通知。这是 drover 唯一
    为了「别重复烦人」存的东西，删掉只会把还开着的条目再通知一次。通知发不出去就跳过，
    不影响循环。"""
    try:
        seen = set(json.loads(B.read(state_path) or "[]"))
    except ValueError:
        seen = set()
    current = []
    for p in projects:
        items = B.wait_items(p)
        current += [k for k, _ in items]
        new = [text for k, text in items if k not in seen]
        if not new:
            continue
        body = " ".join((new[0] if len(new) == 1 else f"{len(new)} 条新的：{new[0]}").split())[:220]
        script = f"display notification {applescript_str(body)} with title {applescript_str('drover · ' + p['name'] + ' 等你')}"
        try:
            subprocess.run([NOTIFY_BIN, "-e", script], capture_output=True, timeout=10)
        except Exception:
            pass
    os.makedirs(os.path.dirname(state_path), exist_ok=True)
    tmp = f"{state_path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(sorted(current), f, ensure_ascii=False)
        os.replace(tmp, state_path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


NOTIFY_EVERY = 60        # 两次「看有没有新的等你」之间至少隔这么久
_looked_at = 0.0         # 上次看的时刻。引擎是常驻进程，记在内存里就够，不用落文件


def tick(list_path):
    """一跳：推一次外层循环，隔够了就再看一眼有没有新的「等你」要通知。叫 tick 不叫
    loop_tick，免得和 drover-board 里那个（真正干活的那个）看混。

    通知这半边要节流，循环推进那半边不能：看一眼要跑一整趟 `collect()`——每个项目十来个
    git 子进程外加一次 corral status——而引擎默认 5 秒一跳，常驻一天就是一万七千多趟。
    节流的是**多久看一次**；哪些已经通知过仍旧全靠 board-notified.json 去重，那套一个字没动。
    `--once` 每次都是新进程，所以手动跑一跳照样会看。"""
    global _looked_at
    B.loop_tick(list_path)
    now = time.time()
    if now - _looked_at < NOTIFY_EVERY:
        return
    _looked_at = now
    notify_new(B.collect(list_path), NOTIFY_STATE)


def cmd_loop_run(list_path, once, interval):
    """外层循环的引擎，独立进程。一跳做什么全在 drover-board.loop_tick 里，这里只管「多久一跳」、
    「一跳出错不许把进程带走」，外加每跳发一次系统通知。

    以前它是 `drover board serve` 里的一个守护线程——**不开那个网页服务，外层循环一跳都不转**，
    「无人值守」根本不成立。拆出来之后看板退回纯观察者：开不开、关没关，都不影响循环。

    哪个项目转不转不在这里判断，看它交接目录里有没有 loop 文件（`drover loop on/off`）。
    这个命令不需要待在某个仓库里，所以不走 setup()。"""
    if once:
        tick(list_path)
        return 0
    print(f"drover loop：每 {interval} 秒一跳，项目清单 {list_path or '~/.drover/projects'}", flush=True)
    while True:
        try:
            tick(list_path)
        except Exception as e:                       # 一个项目出岔子，不能把整条循环带走
            print(f"loop_tick: {e}", file=sys.stderr, flush=True)
        time.sleep(interval)


def cmd_loop(on):
    if on:
        with open(LOOP, "w", encoding="utf-8") as f:     # 重写一遍：修改时间就是这次开循环的时刻（「连续做了几个」从这里数）
            f.write(f"{int(time.time())}\n")
        print("循环已开：主控空闲下来自动核对判据、自动记 done。下一件发不发看 TASK_GATE——"
              "放行模式（默认）等人 drover go，自动模式直接发。停在队列那一步（队列空 / 暂停 / 等放行）时，"
              "条件满足后引擎会叫醒它。\n"
              "  注意：真正推动它的是引擎进程 `drover loop`，这个开关只是告诉引擎「这个项目要转」。"
              "引擎没跑，开关开着也不会动。\ndrover loop off 关掉。")
    else:
        for f in (LOOP, f"{D}/.loop-wait"):
            if os.path.exists(f):
                os.remove(f)
        print("循环已关：回到原来的样子，做完按 TASK_GATE 等放行或继续，写手停下后要人叫。")
    return 0


def cmd_pause(on):
    if on:
        open(PAUSED, "a").close()
        print("已暂停：不再发新任务，正在做的会做完。运行 drover resume 恢复。")
    else:
        if os.path.exists(PAUSED):
            os.remove(PAUSED)
        print("已恢复：写手下次运行 drover next 会拿到新任务。")
    return 0


def span(a, b):
    if not a or not b:
        return ""
    m = max(0, int(b - a)) // 60
    return f"{m // 60}h {m % 60:02d}m" if m >= 60 else f"{m}m"


def cmd_list():
    tasks, current, awaiting = fold()
    todo = pending(tasks)
    mode = ("循环 + 放行模式（自动核对判据，下一件等人放行）" if GATE else "循环 + 自动模式（做完直接领下一个）") if loop_on() \
        else ("放行模式" if GATE else "自动模式")
    print(f"模式：{mode}" + ("（已暂停）" if os.path.exists(PAUSED) else "")
          + (f"；{awaiting} 已完成，等人放行" if awaiting else ""))
    print("\n进行中：")
    print(f"  {current['id']} {current['title']}（开始于 {current['start'][:7]}）" if current else "  （无）")
    print("\n队列：")
    for i, b in enumerate(todo, 1):
        print(f"  {i}. {b['id'] or '（未编号）'} {b['title']}" + ("  ← 下一个" if i == 1 else ""))
    if not todo:
        print("  （空）")
    fin = [t for t in tasks.values() if t["status"] != "doing"]
    print("\n已完成 / 放弃：")
    for t in reversed(fin[-10:]):
        if t["status"] == "done":
            print(f"  {t['id']} {t['title']} · {span(t.get('t0'), t.get('t1'))} · {t['start'][:7]}..{t['end'][:7]}")
        else:
            print(f"  {t['id']} {t['title']} · 放弃" + (f"：{t['reason']}" if t.get("reason") else ""))
    if not fin:
        print("  （无）")
    return 0


def cmd_init(short):
    """把当前仓库接上 drover。只写两处：仓库里的 .drover.conf（并加进 .gitignore），
    和 ~/.drover/ 下的交接目录与项目清单。不建 worktree、不开 agent、不碰目标仓库的源码。
    幂等：已经存在的不覆盖，只报告。"""
    if not short or not re.fullmatch(r'[a-z0-9-]+', short):
        die(2, "ERROR: 短名只允许小写字母、数字和连字符。例如：drover init inksample")
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if r.returncode:
        die(2, "ERROR: 不在 git 仓库里。到项目目录里运行 drover init。")
    repo = r.stdout.strip()
    home = os.path.expanduser("~/.drover")
    d = f"{home}/{short}"
    print(f"仓库:     {repo}\n交接目录: {d}\n")

    conf = f"{repo}/.drover.conf"
    if os.path.exists(conf):
        print("  = .drover.conf 已存在，跳过（要改直接编辑它）")
    else:
        with open(conf, "w", encoding="utf-8") as f:
            f.write(CONF_TEMPLATE.format(dir=d))
        print("  ✓ 写好 .drover.conf")

    gi = f"{repo}/.gitignore"
    if ".drover.conf" not in (B.read(gi) or "").splitlines():
        with open(gi, "a", encoding="utf-8") as f:
            f.write(".drover.conf\n")
        print("  ✓ .drover.conf 加入 .gitignore")

    os.makedirs(home, exist_ok=True)
    plist = f"{home}/projects"
    if repo not in (B.read(plist) or "").splitlines():
        with open(plist, "a", encoding="utf-8") as f:
            f.write(repo + "\n")
        print("  ✓ 登记到 ~/.drover/projects（看板的项目清单，不登记就看不见）")

    os.makedirs(d, exist_ok=True)
    print("  ✓ 交接目录就绪")
    mark = B.parse_conf(conf).get("DONE_MARK", "收尾").strip()
    print(f"\n接好了。下一步：\n"
          f"  1. 编辑 {conf}，填上 MAIN_AGENT（主控在 corral 里的名字）\n"
          f"  2. 自己开主控：corral start <名字> …    —— drover 不开、不关、不接入\n"
          f'  3. drover add "标题" …  然后  drover next')
    if mark:
        print(f"\n还有一件要你自己做：把下面这一行加进 {repo}/AGENTS.md 的「开发方式（主控分派）」那一节，\n"
              f"挨着「合并：」那行。drover 靠它判断一件活完没完，不加就判不出来：\n\n"
              f"  - 收尾记号：一件活合并完、worktree 和分支清干净之后，在 main 上补一条空提交\n"
              f"    （git commit --allow-empty），首行写「{mark}: 」加一句话说明这件活是什么。\n"
              f"    只记真正落地的活；说好不合并、停在审查的不记。\n\n"
              f"（新项目按 corral 的 项目AGENTS模板.md 建的话本来就有这条，核对一下前缀是不是 {mark}。\n"
              f" 这个项目不想用收尾记号，就把 .drover.conf 里的 DONE_MARK 留空。）")
    return 0


CONF_TEMPLATE = """# drover 的项目配置。一行一个 `键=值`，# 开头是注释。这个文件不进 git。

# 交接目录：queue.md（归人）和 tasks.state（归 drover）都在这里。
HANDOFF_DIR={dir}

# 主控的 corral 名字，`corral ls` 里看得到的那个。drover 只对它 send / status，
# 不开、不关、不接入。留空就是不自动送：drover next 会把任务正文打出来让你自己粘。
MAIN_AGENT=

# 验收命令。完成判据第 3 条跑它，退出码 0 才算过。**留空 = 这个项目不跑验收**，
# 第 3 条恒为「不适用」，不参与判断（依据仍然只有收尾记号，判据 1、2 照旧）。
# 例：CHECK_CMD=uv run pytest -q
# 只有这一个来源：queue.md 正文里写什么都不当命令跑（「验收：<命令>」那条覆盖语法
# 2026-09-21 删了——帮助里说 queue.md「下面随意写约束和验收」，和它不能同时成立）。
CHECK_CMD=

# 收尾记号的前缀。主控一件活收尾时在 main 上打一条空提交，首行「<前缀>: 一句话」，
# drover 认出它才算这件活完了。**同一个值要在项目自己的 AGENTS.md 里也写一遍**
# （那份是给主控看的，drover 不去解析它），两处别写岔了。
# 留空 = 这个项目不打收尾记号：drover 判不出完成，循环开着也不会自动记 done，停下等人 drover go。
DONE_MARK=收尾

# 任务文件目录，相对仓库根，例：TASK_FILE_DIR=docs/任务。看板拿它找这件活的任务文件
# （文件名以队列条目标题开头的那个 .md），读开头那行「路由：…」显示出来——**只显示，
# 绝不参与任何判断**，读不出来就是不显示这一项。队列条目正文里写了「任务文件：<相对路径>」
# 的以它为准。留空 = 不找任务文件，路由那一项不显示。
TASK_FILE_DIR=

# 放行模式：1（默认）每个任务做完等人 go；0 自动模式，做完直接发下一件。
# 和 `drover loop on/off` 两个开关叠起来是三档，默认全关：
#   loop off            什么都不自动（默认）
#   loop on + GATE=1    自动核对判据、自动记 done，下一件等人放行
#   loop on + GATE=0    全自动，无人值守
# TASK_GATE=1
"""


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if argv else 2
    if argv[0] == "board":                  # drover board … → 转给看板，参数原样透传
        board = os.path.join(os.path.dirname(os.path.realpath(__file__)), "drover-board")
        os.execv(sys.executable, [sys.executable, board, *argv[1:]])
    if argv[0] == "init":
        return cmd_init(argv[1] if len(argv) > 1 else "")
    if argv[0] == "loop" and argv[1:2] not in (["on"], ["off"]):
        rest, once, list_path, interval = argv[1:], False, "", 5.0
        while rest:
            a = rest.pop(0)
            if a == "--once":
                once = True
            elif a == "--projects" and rest:
                list_path = rest.pop(0)
            elif a == "--interval" and rest:
                try:
                    interval = float(rest.pop(0))
                except ValueError:
                    die(2, "ERROR: --interval 要跟一个秒数")
            else:
                die(2, f"ERROR: drover loop 不认识这个参数：{a}\n\n{__doc__.strip()}")
        return cmd_loop_run(list_path, once, interval)
    setup()
    cmd, rest = argv[0], argv[1:]
    expect = None
    if "--expect" in rest:
        k = rest.index("--expect")
        if k + 1 >= len(rest):
            die(2, "ERROR: --expect 后面要跟 queue.md 的指纹")
        expect, rest = rest[k + 1], rest[:k] + rest[k + 2:]
        if cmd not in ("move", "edit", "drop", "hold"):
            die(2, "ERROR: --expect 只用于 move / edit / drop --pos / hold")
    if cmd == "add" and rest:
        return cmd_add(rest[0], rest[1:])
    if cmd == "list" and not rest:
        return cmd_list()
    if cmd == "next" and not rest:
        return cmd_next()
    if cmd == "done" and len(rest) == 1:
        return cmd_done(rest[0].upper())
    if cmd == "go" and not rest:
        return cmd_go()
    if cmd == "drop" and len(rest) >= 2 and rest[0] == "--pos":
        return cmd_drop_pos(rest[1], " ".join(rest[2:]), expect)
    if cmd == "drop" and rest and not expect:
        return cmd_drop(rest[0].upper(), " ".join(rest[1:]))
    if cmd == "move" and len(rest) == 2:
        return cmd_move(rest[0], rest[1], expect)
    if cmd == "edit" and len(rest) >= 2:
        return cmd_edit(rest[0], rest[1], rest[2:], expect)
    if cmd == "hold" and len(rest) == 2 and rest[1] in ("on", "off"):
        return cmd_hold(rest[0], rest[1] == "on", expect)
    if cmd == "loop" and rest in (["on"], ["off"]):
        return cmd_loop(rest[0] == "on")
    if cmd in ("pause", "resume") and not rest:
        return cmd_pause(cmd == "pause")
    die(2, f"ERROR: 用法不对：drover {' '.join(argv)}\n\n{__doc__.strip()}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
