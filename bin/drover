#!/usr/bin/env python3
"""Drover: explicit task submission and acceptance.

  list --json / show Tn --json [--with-agent-status]
  dispatch-pending --pos N --target-token TOKEN --json
  done Tn --target-token TOKEN --json           Running -> Awaiting release
  go Tn --target-token TOKEN --json             Awaiting release -> Done
  return-to-pending Tn --target-token TOKEN --reason TEXT --work-stopped --json
  pause / resume                              Control explicit dispatch only
  add TITLE [NOTES ...] / edit POS TITLE [NOTES ...] / move FROM TO / drop --pos POS
  notifications status|on|off --json
  notifications watch [--once] [--projects FILE] [--interval SECONDS]
  board / init SHORTNAME

Task JSON schema 2. Read action tokens from list/show. Old next, loop, hold,
complete-manually and unqualified go are retired; no automatic progression.
Task API exits: 0 success; 2 arguments/data unavailable; 3 stale/illegal target;
4 writer busy; 5 write failed; 8 delivery rejected/unconfirmed/unknown.
Queue editing retains --expect queue fingerprint (conflict exit 10).
"""
import argparse
import importlib.machinery
import importlib.util
import fcntl
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import drover_core as C
UI_ENGLISH = os.environ.get('DROVER_BOARD_ENGLISH') == '1'
def ui(zh, en):
    """Keep CLI output unchanged; the board requests English operation feedback."""
    return en if UI_ENGLISH else zh


def print_text(text):
    """只在输出时转义代理码；任务正文和判据理由仍保留原字符。"""
    print(re.sub(r"[\ud800-\udfff]", lambda m: f"\\u{ord(m[0]):04x}", text))


def die(code, msg):
    print(msg)
    sys.exit(code)


def load_board():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "drover-board")
    if not os.path.exists(path):
        die(2, f"ERROR: 找不到 {path}。drover 命令、看板和共享核心必须保留在同一个目录里。")
    loader = importlib.machinery.SourceFileLoader("drover_board", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("drover_board", loader))
    loader.exec_module(mod)
    return mod


B = load_board()
REPO = D = Q = S = PAUSED = ''

def setup():
    global REPO, D, Q, S, PAUSED
    REPO = C.locate_project()
    snap = C.snapshot(REPO, config_only=True)
    D = snap['directory']
    Q, S, PAUSED = (os.path.join(D, x) for x in ('queue.md', 'tasks.state', 'paused'))

def parse_queue():
    return C.task_blocks(C.read(Q))

def fold():
    snap = C.snapshot(REPO)
    return snap['tasks'], snap['current'], snap['awaiting']

def append(event):
    C.append_event(C.snapshot(REPO), {'t': time.time(), **event})

def next_num(blocks=None, tasks=None):
    ids = [b["id"] for b in (parse_queue() if blocks is None else blocks) if b["id"]]
    ids += list(fold()[0] if tasks is None else tasks)
    return max([int(i[1:]) for i in ids if re.fullmatch(r"T\d+", i or "")], default=0) + 1


def split_blocks(text):
    """queue.md → (第一个 ## 之前的前言, [每块的原文])；和看板的 task_blocks 用同一个标题行判据，逐行原样保留。"""
    pre, blocks = [], []
    for line in (text or "").splitlines(keepends=True):
        if B.TASK_HDR.match(line.rstrip("\r\n")):
            blocks.append([line])
        elif blocks:
            blocks[-1].append(line)
        else:
            pre.append(line)
    return "".join(pre), ["".join(b) for b in blocks]


def join_blocks(pre, blocks):
    """块之间至少隔一个空行；只补缺的，不动原有的空行。"""
    out = pre
    for i, b in enumerate(blocks):
        if out and not out.endswith("\n"):
            out += "\n"
        if i and not out.endswith("\n\n"):
            out += "\n"
        out += b
    return out if out.endswith("\n") else out + "\n"


def write_queue(text):
    C.atomic_write(Q, text)


def pending_slots(expect):
    """→ (前言, 各块原文, 待办块在各块里的下标)。--expect 对不上直接退出 10。"""
    text = B.read(Q) or ""
    if expect and expect != B.queue_version(text):
        die(10, "CONFLICT: queue.md 在这期间被改过（别人刚加了或改了任务），什么都没写。刷新后再操作。")
    pre, raw = split_blocks(text)
    parsed = [B.task_blocks(r)[0] for r in raw]
    tasks = fold()[0]
    return pre, raw, [i for i, block in enumerate(parsed) if C.task_pending([block], tasks)]


def check_task_text(title, notes):
    if not title or "\n" in title:
        die(2, "ERROR: 标题要是一行非空的文字")
    bad = [n for n in notes if B.TASK_HDR.match(n)]
    if bad:
        die(2, f"ERROR: 说明里顶格的「## 」会被当成另一个任务：{bad[0]}；小标题请用 ###")


def slot(pos, slots):
    if not re.fullmatch(r"\d+", pos or "") or not 1 <= int(pos) <= len(slots):
        die(2, f"ERROR: 位置要是 1 到 {len(slots)} 之间的数字（队列里还没开始的任务按顺序数），现在是 {pos}")
    return int(pos) - 1


def cmd_move(src, dst, expect):
    pre, raw, slots = pending_slots(expect)
    a, b = slot(src, slots), slot(dst, slots)
    if a == b:
        print("位置没变。")
        return 0
    order = [raw[i].rstrip("\r\n") + "\n" for i in slots]   # 挪动的块去掉尾部空行，块间空行由 join_blocks 统一补
    block = order.pop(a)
    order.insert(b, block)
    for i, r in zip(slots, order):          # 待办块只在自己原来占的那几个位置里换，前言和开始过的块不动
        raw[i] = r
    write_queue(join_blocks(pre, [r if r.endswith("\n") else r + "\n" for r in raw]))
    t = B.task_blocks(block)[0]
    print(f"已把 {t['id'] or '（未编号）'} {t['title']} 挪到队列第 {b + 1} 个。")
    return 0


def cmd_edit(pos, title, notes, expect):
    title = title.strip()
    check_task_text(title, notes)
    pre, raw, slots = pending_slots(expect)
    i = slots[slot(pos, slots)]
    old = B.task_blocks(raw[i])[0]
    raw[i] = f"## {old['id'] + ' ' if old['id'] else ''}{title}\n" + "".join(n.rstrip("\n") + "\n" for n in notes)
    write_queue(join_blocks(pre, [r if r.endswith("\n") else r + "\n" for r in raw]))
    print(f"已改写队列第 {int(pos)} 个：{old['id'] or '（未编号）'} {title}")
    return 0


def cmd_add(title, notes):
    title = title.strip()
    if not title or "\n" in title:
        die(2, "ERROR: 标题要是一行非空的文字")
    tid = f"T{next_num()}"
    text = B.read(Q) or ""
    sep = "" if not text or text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
    with open(Q, "a", encoding="utf-8") as f:
        f.write(sep + f"## {tid} {title}\n" + "".join(n.rstrip("\n") + "\n" for n in notes))
    print(f"已加入队列末尾 {tid}：{title}")
    return 0


def cmd_drop(tid, reason):
    tasks, _, _ = fold()
    t = tasks.get(tid)
    if t and t["status"] != "pending":
        die(2, f"ERROR: {tid} 已经{'完成' if t['status'] == 'done' else '放弃'}了")
    if not t:
        b = next((b for b in parse_queue() if b["id"] == tid), None)
        if not b:
            die(2, f"ERROR: 找不到 {tid}：它不在进行中，队列里也没有这个编号")
        t = {"title": b["title"], "key": b["title"]}
    append({"ev": "drop", "id": tid, "title": t["title"], "key": t.get("key") or t["title"], "reason": reason})
    print(f"已放弃 {tid}：{t['title']}" + (f"（{reason}）" if reason else ""))
    return 0


def cmd_drop_pos(pos, reason, expect):
    """按队列位置放弃还没开始的任务。有编号走 cmd_drop；没编号的在 tasks.state 里给个编号、以标题为 key 记下，
    task_pending 按标题认出它已放弃（和明确派发未编号任务同一个办法）；queue.md 原文不动。"""
    _, raw, slots = pending_slots(expect)
    b = B.task_blocks(raw[slots[slot(pos, slots)]])[0]
    if b["id"]:
        return cmd_drop(b["id"], reason)
    tid = f"T{next_num()}"
    append({"ev": "drop", "id": tid, "title": b["title"], "key": b["title"], "reason": reason})
    print(f"已放弃 {tid}：{b['title']}" + (f"（{reason}）" if reason else "")
          + "。queue.md 里这块没编号，按标题认：之后再手写同名的没编号任务也会被当成已放弃，换个标题或加上编号。")
    return 0


def cmd_pause(on):
    if on:
        open(PAUSED, "a").close()
        print(ui("已暂停：不再发新任务，正在做的会做完。运行 drover resume 恢复。",
                 "Paused: no new tasks will be sent."))
    else:
        if os.path.exists(PAUSED):
            os.remove(PAUSED)
        print(ui("已恢复：可以重新明确派发待办；不会自动派发。",
                 "Resumed: explicit dispatch is enabled."))
    return 0


NOTIFY_BIN = os.environ.get("DROVER_NOTIFY_BIN", "osascript")
NOTIFY_STATE = os.path.expanduser("~/.drover/board-notified.json")
NOTIFY_PREFS = os.path.expanduser("~/.drover/notifications.json")
_notify_revision = None
_notify_baselined = set()
class NotificationError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def notification_preferences():
    try:
        with open(NOTIFY_PREFS, encoding="utf-8") as source:
            value = json.load(source)
    except FileNotFoundError:
        return {"schema_version": 1, "system_enabled": True, "revision": 0}
    except (ValueError, UnicodeError):
        raise NotificationError("preferences_invalid", "通知偏好格式损坏")
    except OSError:
        raise NotificationError("preferences_unreadable", "无法读取通知偏好")
    if (not isinstance(value, dict) or type(value.get("schema_version")) is not int
            or value["schema_version"] != 1 or type(value.get("system_enabled")) is not bool
            or type(value.get("revision")) is not int or value["revision"] < 0):
        raise NotificationError("preferences_invalid", "通知偏好字段无效")
    return value


def write_notification_json(path, value):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".notifications-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as target:
            json.dump(value, target, ensure_ascii=True)
            target.flush()
            os.fsync(target.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def cmd_notifications(args):
    try:
        if len(args) != 2 or args[0] not in ("status", "on", "off") or args[1] != "--json":
            raise NotificationError("invalid_arguments", "用法：drover notifications status|on|off --json")
        if args[0] == "status":
            value = notification_preferences()
        else:
            # 串行化偏好读改写，重复 on/off 不增加 revision；status 无锁且不创建文件。
            os.makedirs(os.path.dirname(NOTIFY_PREFS), exist_ok=True)
            with open(NOTIFY_PREFS + ".lock", "a") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                value = notification_preferences()
                enabled = args[0] == "on"
                if value["system_enabled"] != enabled:
                    value = {"schema_version": 1, "system_enabled": enabled,
                             "revision": value["revision"] + 1}
                    write_notification_json(NOTIFY_PREFS, value)
        result = {"schema_version": 1, "ok": True, "scope": "user",
                  "system_enabled": value["system_enabled"], "revision": value["revision"],
                  "application": "next_notification_check"}
    except (NotificationError, OSError) as exc:
        result = {"schema_version": 1, "ok": False,
                  "error": {"code": exc.code if isinstance(exc, NotificationError) else "preferences_write_failed",
                            "message": str(exc) if isinstance(exc, NotificationError) else "无法保存通知偏好"}}
    print(json.dumps(result, ensure_ascii=True))
    return 0 if result["ok"] else 2


def applescript_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def notify_new(projects, state_path, preferences):
    """每次进程启动/偏好 revision 变化先立基线；保留所有已处理身份，发送前记账。"""
    global _notify_revision, _notify_baselined
    seen = set()
    reset = _notify_revision != preferences["revision"]
    try:
        with open(state_path, encoding="utf-8") as source:
            record = json.load(source)
        if (not isinstance(record, dict) or record.get("schema_version") != 1
                or not isinstance(record.get("seen"), list)
                or not all(isinstance(k, str) for k in record["seen"])):
            raise ValueError("old or invalid notification record")
        seen = set(record["seen"])
    except (FileNotFoundError, ValueError, UnicodeError):
        reset = True               # 首次升级/记录丢失或损坏：不补弹现有事项。
    baselined = set() if reset else _notify_baselined.copy()
    pending = []
    for repo, task in projects.items():
        key = notification_identity(repo, task)
        if key is not None:
            if preferences["system_enabled"] and repo in baselined and key not in seen:
                pending.append((repo, task))
            seen.add(key)
        baselined.add(repo)
    write_notification_json(state_path, {"schema_version": 1, "seen": sorted(seen)})
    _notify_revision, _notify_baselined = preferences["revision"], baselined
    for repo, task in pending:
        body = " ".join(f"{task['id']} {task.get('title', '')} 已提交，正在等待验收。".split())[:220]
        script = f"display notification {applescript_str(body)} with title {applescript_str('drover · ' + os.path.basename(repo) + ' 等你')}"
        try:
            subprocess.run([NOTIFY_BIN, "-e", script], capture_output=True, timeout=10)
        except (OSError, subprocess.SubprocessError):
            pass                    # 尽力发送，无重试；记录不是送达证明。


def notification_snapshot(list_path):
    projects = {}
    for repo in B.discover(list_path):
        try:
            snap = C.snapshot(repo)
            projects[snap['repo']] = snap['tasks'].get(snap['awaiting'])
        except C.FlowError:
            continue
    return projects

notification_identity = C.notification_identity


def tick(list_path):
    # Observer only: no Git, agent checks, or task mutation calls.
    try:
        notify_new(notification_snapshot(list_path), NOTIFY_STATE, notification_preferences())
    except Exception as exc:
        print(f'notification check: {exc}', file=sys.stderr, flush=True)

def watch(args):
    parser = Parser(prog='drover notifications watch')
    parser.add_argument('--once', action='store_true')
    parser.add_argument('--projects', default='')
    parser.add_argument('--interval', type=float, default=60)
    opt = parser.parse_args(args)
    if not math.isfinite(opt.interval) or opt.interval <= 0:
        raise C.FlowError('invalid_arguments', 'interval 必须是有限正数')
    while True:
        tick(opt.projects)
        if opt.once:
            return 0
        time.sleep(opt.interval)

class Parser(argparse.ArgumentParser):
    def error(self, message):
        if self.prog == 'drover go':
            message = 'go 只接受 Awaiting；Running 请先 done。' + message
        raise C.FlowError('invalid_arguments', message)

def result(value):
    print(json.dumps(value, ensure_ascii=True))
    if value.get('ok', False):
        return 0
    return {'target_changed': 3, 'invalid_state': 3, 'current_exists': 3, 'awaiting_release': 3,
            'paused': 3, 'state_busy': 4, 'write_failed': 5, 'send_rejected': 8,
            'delivery_unconfirmed': 8, 'delivery_unknown': 8}.get(value['error']['code'], 2)

def task_command(command, args):
    parser = Parser(prog='drover ' + command)
    if command == 'dispatch-pending':
        parser.add_argument('--pos', required=True, type=int)
    else:
        parser.add_argument('task_id')
    parser.add_argument('--target-token', required=True)
    parser.add_argument('--json', required=True, action='store_true')
    if command == 'return-to-pending':
        parser.add_argument('--reason', required=True)
        parser.add_argument('--work-stopped', required=True, action='store_true')
    if len([a for a in args if a.startswith('--')]) != len(set(a for a in args if a.startswith('--'))):
        raise C.FlowError('invalid_arguments', '选项不能重复')
    opt = parser.parse_args(args)
    if not re.fullmatch(r'v2:[0-9a-f]{64}', opt.target_token):
        raise C.FlowError('invalid_arguments', '需要 list/show 提供的 v2 目标令牌')
    setup()
    if command == 'dispatch-pending':
        if opt.pos < 1:
            raise C.FlowError('invalid_arguments', '位置必须是正整数')
        return result(C.dispatch(REPO, opt.pos, opt.target_token, B.corral))
    if not re.fullmatch(r'T[0-9]+', opt.task_id):
        raise C.FlowError('invalid_arguments', '任务编号必须为 Tn')
    return result(C.transition(REPO, command, opt.task_id, opt.target_token,
                              getattr(opt, 'reason', ''), getattr(opt, 'work_stopped', False)))

def cmd_list(as_json=False):
    value = C.listing(C.snapshot(REPO))
    if as_json:
        return result(value)
    print('明确提交 / 用户接受' + ('（已暂停派发）' if value['paused'] else ''))
    for key, label in (('current', '进行中'), ('awaiting', '待验收')):
        task = value[key]
        print_text(f"{label}：" + (f"{task['id']} {task['title']}" if task else '（无）'))
    print('队列：')
    for pos, task in enumerate(value['pending'], 1):
        print_text(f"  {pos}. {task['id'] or '（未编号）'} {task['title']}")
    print('历史：')
    for task in value['history'][:10]:
        print_text(f"  {task['id']} {task['title']} · {task['status']}")
    return 0

def cmd_show(args):
    parser = Parser(prog='drover show')
    parser.add_argument('task_id')
    parser.add_argument('--json', required=True, action='store_true')
    parser.add_argument('--with-agent-status', action='store_true')
    opt = parser.parse_args(args)
    setup()
    snap = C.snapshot(REPO)
    value = C.listing(snap)
    candidates = [value['current'], value['awaiting'], *value['pending'], *value['history']]
    task = next((t for t in candidates if t and t['id'] == opt.task_id), None)
    if not task:
        raise C.FlowError('task_not_found', '没有该任务')
    value = {'schema_version': 2, 'ok': True, 'project': snap['repo'], 'task': task,
             'evidence': C.evidence(snap, task)}
    if opt.with_agent_status:
        agent = snap['conf'].get('MAIN_AGENT', '')
        value['agent_status'] = B.corral_status(agent) if agent else None
    C.ensure_fresh(snap)
    return result(value)

def cmd_init(short):
    """把当前仓库接上 drover。只写两处：仓库里的 .drover.conf（并加进 .gitignore），
    和 ~/.drover/ 下的交接目录与项目清单。不建 worktree、不开 agent、不碰目标仓库的源码。
    幂等：已经存在的不覆盖，只报告。"""
    if not short or not re.fullmatch(r'[a-z0-9-]+', short):
        die(2, "ERROR: 短名只允许小写字母、数字和连字符。例如：drover init inksample")
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if r.returncode:
        die(2, "ERROR: 不在 git 仓库里。到项目目录里运行 drover init。")
    repo = r.stdout.strip()
    home = os.path.expanduser("~/.drover")
    d = f"{home}/{short}"
    print(f"仓库:     {repo}\n交接目录: {d}\n")

    conf = f"{repo}/.drover.conf"
    if os.path.exists(conf):
        print("  = .drover.conf 已存在，跳过（要改直接编辑它）")
    else:
        with open(conf, "w", encoding="utf-8") as f:
            f.write(CONF_TEMPLATE.format(dir=d))
        print("  ✓ 写好 .drover.conf")

    gi = f"{repo}/.gitignore"
    if ".drover.conf" not in (B.read(gi) or "").splitlines():
        with open(gi, "a", encoding="utf-8") as f:
            f.write(".drover.conf\n")
        print("  ✓ .drover.conf 加入 .gitignore")

    os.makedirs(home, exist_ok=True)
    plist = f"{home}/projects"
    if repo not in (B.read(plist) or "").splitlines():
        with open(plist, "a", encoding="utf-8") as f:
            f.write(repo + "\n")
        print("  ✓ 登记到 ~/.drover/projects（看板的项目清单，不登记就看不见）")

    os.makedirs(d, exist_ok=True)
    print("  ✓ 交接目录就绪")
    print("接好了。填写 MAIN_AGENT、加入任务后，读取 list --json 的明确派发目标。")
    return 0


CONF_TEMPLATE = """# Drover 项目配置；无自动推进或统一完成门槛。
HANDOFF_DIR={dir}
# 留空：明确派发时只返回正文，让人粘贴。
MAIN_AGENT=
# 仅供看板展示任务文件与路由。
TASK_FILE_DIR=
"""

def main(argv):
    try:
        if not argv or argv[0] in ('-h', '--help', 'help'):
            print(__doc__.strip())
            return 0 if argv else 2
        command, args = argv[0], argv[1:]
        if command in ('next', 'loop', 'hold', 'complete-manually'):
            raise C.FlowError('command_retired', '旧自动/覆盖路径已退役。读取 list/show --json；使用明确 dispatch-pending、done、go。通知用 notifications watch')
        if command in (*C.TRANSITIONS, 'dispatch-pending'):
            return task_command(command, args)
        if command == 'notifications':
            return watch(args[1:]) if args[:1] == ['watch'] else cmd_notifications(args)
        if command == 'show':
            return cmd_show(args)
        if command == 'board':
            path = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'drover-board')
            os.execv(sys.executable, [sys.executable, path, *args])
        if command == 'init' and len(args) == 1:
            return cmd_init(args[0])
        setup()
        if command == 'list' and args in ([], ['--json']):
            return cmd_list(bool(args))
        directory = D
        with C.task_write_lock(directory):
            setup()
            if D != directory:
                raise C.FlowError('target_changed', '配置在取锁期间改变')
            C.snapshot(REPO)
            return project_command(argv)
    except C.FlowError as exc:
        return result({'schema_version': 2, 'ok': False, 'error': {'code': exc.code, 'why': exc.why}})
    except OSError as exc:
        return result({'schema_version': 2, 'ok': False, 'error': {'code': 'write_failed', 'why': str(exc)}})

def project_command(argv):
    cmd, rest = argv[0], argv[1:]
    expect = None
    if "--expect" in rest:
        k = rest.index("--expect")
        if k + 1 >= len(rest):
            die(2, "ERROR: --expect 后面要跟 queue.md 的指纹")
        expect, rest = rest[k + 1], rest[:k] + rest[k + 2:]
        if cmd not in ("move", "edit", "drop"):
            die(2, "ERROR: --expect 只用于 move / edit / drop --pos")
    if cmd == "add" and rest:
        return cmd_add(rest[0], rest[1:])
    if cmd == "list" and rest in ([], ["--json"]):
        return cmd_list(as_json=bool(rest))
    if cmd == "drop" and len(rest) >= 2 and rest[0] == "--pos":
        return cmd_drop_pos(rest[1], " ".join(rest[2:]), expect)
    if cmd == "drop" and rest and not expect:
        return cmd_drop(rest[0].upper(), " ".join(rest[1:]))
    if cmd == "move" and len(rest) == 2:
        return cmd_move(rest[0], rest[1], expect)
    if cmd == "edit" and len(rest) >= 2:
        return cmd_edit(rest[0], rest[1], rest[2:], expect)
    if cmd in ("pause", "resume") and not rest:
        return cmd_pause(cmd == "pause")
    die(2, f"ERROR: 用法不对：drover {' '.join(argv)}\n\n{__doc__.strip()}")


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
